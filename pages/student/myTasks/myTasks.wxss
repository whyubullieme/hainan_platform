/* pages/student/myTasks/myTasks.wxss */
.container {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.section {
  padding: 32rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.plan-intro {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.plan-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.total-days {
  font-size: 28rpx;
  color: #07c160;
  font-weight: 500;
}

.pagination {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.page-btn {
  font-size: 26rpx;
  color: #07c160;
}

.page-btn.disabled {
  color: #ccc;
}

.page-info {
  font-size: 24rpx;
  color: #666;
}

.task-placeholder {
  padding: 32rpx;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

.day-block {
  margin-bottom: 32rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.day-header {
  padding: 24rpx 32rpx;
  background: #f8f9fa;
}

.day-header.today {
  background: #e8f4fd;
}

.day-header.expired {
  background: #fff7e6;
}

.day-header.locked {
  background: #f5f5f5;
  opacity: 0.8;
}

.day-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.day-badge {
  float: right;
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  background: #07c160;
  color: #fff;
  border-radius: 8rpx;
}

.day-badge.expired {
  background: #fa8c16;
}

.day-badge.locked {
  background: #999;
}

.task-list {
  padding: 16rpx 32rpx;
}

.task-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.task-item:last-child {
  border-bottom: none;
}

.task-content {
  flex: 1;
}

.task-title {
  font-size: 30rpx;
  color: #333;
  display: block;
}

.task-status {
  font-size: 24rpx;
  color: #07c160;
  margin-top: 8rpx;
}

.task-status.pending {
  color: #fa8c16;
}

.action-btn {
  background: #07c160;
  color: #fff;
  border: none;
  font-size: 26rpx;
}

.empty-state {
  text-align: center;
  padding: 80rpx;
  color: #999;
  font-size: 28rpx;
}
