/* pages/student/feedback/feedback.wxss */

.container {
  min-height: 100vh;
  background: #f0f4f8;
  padding: 24rpx 28rpx 60rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 24rpx;
}

.reviews-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.review-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.review-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.day-badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  color: #fff;
  border-radius: 20rpx;
  font-weight: 600;
}

.review-date {
  font-size: 22rpx;
  color: #94a3b8;
}

.teacher-name {
  font-size: 24rpx;
  color: #64748b;
}

.review-comment {
  font-size: 28rpx;
  color: #334155;
  line-height: 1.7;
}

.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #94a3b8;
  font-size: 28rpx;
}
