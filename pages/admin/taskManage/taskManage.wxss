/* pages/admin/taskManage/taskManage.wxss */

.container {
  min-height: 100vh;
  padding: 24rpx 28rpx;
  padding-bottom: 48rpx;
  background: #f0f4f8;
}

/* Header */
.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.page-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1e293b;
  letter-spacing: 0.5rpx;
}

.header-actions {
  display: flex;
  gap: 12rpx;
}
.btn-dedup {
  background: #fff;
  color: #ef4444;
  border: 1rpx solid #fca5a5;
  border-radius: 14rpx;
  font-size: 24rpx;
  padding: 14rpx 24rpx;
}
.btn-import {
  background: #fff;
  color: #0f766e;
  border: 1rpx solid #99f6e4;
  border-radius: 14rpx;
  font-size: 24rpx;
  padding: 14rpx 24rpx;
}
.btn-publish {
  background: #fff;
  color: #7c3aed;
  border: 1rpx solid #c4b5fd;
  border-radius: 14rpx;
  font-size: 24rpx;
  padding: 14rpx 24rpx;
}
.btn-add {
  background: linear-gradient(135deg, #10b981, #059669);
  color: #fff;
  border: none;
  border-radius: 14rpx;
  font-size: 26rpx;
  padding: 14rpx 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(16, 185, 129, 0.25);
}

/* Tabs */
.tabs {
  display: flex;
  gap: 10rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}
.status-tabs {
  margin-top: -8rpx;
}

.tab-item {
  padding: 14rpx 24rpx;
  font-size: 26rpx;
  color: #64748b;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 24rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.tab-item.active {
  background: linear-gradient(135deg, #60a5fa, #3b82f6);
  color: #fff;
  border-color: #3b82f6;
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.25);
}

/* Loading */
.loading-tip {
  text-align: center;
  color: #94a3b8;
  padding: 80rpx 0;
  font-size: 28rpx;
}

/* Task list */
.task-list {
  margin-top: 8rpx;
}

.task-card {
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.task-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  flex: 1;
  margin-right: 16rpx;
}

.type-badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  color: #fff;
  font-weight: 500;
}

.type-read_aloud {
  background: linear-gradient(135deg, #60a5fa, #3b82f6);
}

.type-read_along {
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
}

.type-listening_mcq {
  background: linear-gradient(135deg, #34d399, #10b981);
}

.type-dialogue {
  background: linear-gradient(135deg, #a78bfa, #8b5cf6);
}

.card-content {
  margin-bottom: 12rpx;
}

.card-source {
  display: flex;
  gap: 8rpx;
  margin-bottom: 10rpx;
}
.source-tag {
  font-size: 22rpx;
  color: #3b82f6;
  background: #eff6ff;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}
.status-draft {
  color: #92400e;
  background: #ffedd5;
}
.status-published {
  color: #065f46;
  background: #d1fae5;
}

.content-preview {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-meta {
  display: flex;
  margin-bottom: 8rpx;
}

.meta-label {
  font-size: 24rpx;
  color: #94a3b8;
  flex-shrink: 0;
}

.meta-value {
  font-size: 24rpx;
  color: #64748b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f1f5f9;
}

.btn-edit {
  background: #fff;
  color: #3b82f6;
  border: 1rpx solid #3b82f6;
  border-radius: 10rpx;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  font-weight: 500;
}

.btn-edit:active {
  background: #eff6ff;
}

.btn-delete {
  background: #fff;
  color: #ef4444;
  border: 1rpx solid #ef4444;
  border-radius: 10rpx;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  font-weight: 500;
}

.btn-delete:active {
  background: #fef2f2;
}

.empty-tip {
  text-align: center;
  color: #94a3b8;
  padding: 80rpx 0;
  font-size: 28rpx;
}

/* Form modal overlay */
.form-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.5);
  z-index: 100;
}

.form-panel {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  background: #f0f4f8;
  z-index: 101;
  display: flex;
  flex-direction: column;
}

.form-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #e2e8f0;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}

.form-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
}

.form-close {
  font-size: 28rpx;
  color: #64748b;
  padding: 8rpx 16rpx;
  font-weight: 500;
}

.form-close:active {
  color: #1e293b;
}

.form-scroll {
  flex: 1;
  padding: 24rpx 32rpx;
  padding-bottom: 80rpx;
}

.form-row {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  padding: 16rpx 20rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #1e293b;
  box-sizing: border-box;
  transition: border-color 0.2s ease;
}

.form-input:focus {
  border-color: #93c5fd;
}

.form-textarea {
  width: 100%;
  padding: 16rpx 20rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #1e293b;
  min-height: 200rpx;
  box-sizing: border-box;
  transition: border-color 0.2s ease;
}

.form-textarea:focus {
  border-color: #93c5fd;
}

.form-picker {
  padding: 16rpx 20rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #1e293b;
}

.form-picker:active {
  background: #f8fafc;
}

.btn-save {
  margin-top: 40rpx;
  background: linear-gradient(135deg, #10b981, #059669);
  color: #fff;
  border: none;
  border-radius: 14rpx;
  padding: 28rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.25);
  letter-spacing: 1rpx;
}

.btn-save[disabled] {
  opacity: 0.6;
}
