/* pages/admin/classManage/classManage.wxss */

.container {
  min-height: 100vh;
  background: #f0f4f8;
  justify-content: flex-start;
  overflow-y: auto;
}

/* Logout */
.logout-wrap {
  padding: 24rpx 28rpx 0;
  display: flex;
  justify-content: flex-end;
}

.logout-link {
  color: #94a3b8;
  font-size: 24rpx;
}

/* Greeting bar */
.greeting-bar {
  margin: 16rpx 28rpx 8rpx;
  padding: 18rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.greeting-text {
  font-size: 27rpx;
  color: #64748b;
}

/* Section */
.section {
  padding: 24rpx 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 24rpx;
}

/* Form */
.form-row {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  font-size: 27rpx;
  color: #64748b;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.input {
  width: 100%;
  height: 84rpx;
  padding: 0 20rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  font-size: 30rpx;
  line-height: 84rpx;
  box-sizing: border-box;
  color: #1e293b;
}

.picker-value {
  padding: 20rpx 24rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  font-size: 30rpx;
  color: #1e293b;
}

.picker-value:active {
  background: #f8fafc;
}

/* Primary button */
.btn-primary {
  margin-top: 36rpx;
  background: linear-gradient(135deg, #10b981, #059669);
  color: #fff;
  border: none;
  border-radius: 14rpx;
  padding: 26rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(16, 185, 129, 0.25);
}

.btn-primary[disabled] {
  background: #cbd5e1;
  color: #94a3b8;
  box-shadow: none;
}

/* Result box */
.result-box {
  margin: 8rpx 28rpx 48rpx;
  padding: 32rpx;
  background: #eff6ff;
  border: 2rpx solid #3b82f6;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(59, 130, 246, 0.08);
}

.result-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 28rpx;
  color: #3b82f6;
}

.result-item {
  margin-bottom: 28rpx;
}

.result-label {
  display: block;
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}

.code-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
}

.code-text {
  font-size: 38rpx;
  font-weight: 700;
  color: #1e293b;
  letter-spacing: 4rpx;
}

.copy-btn {
  flex-shrink: 0;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #fff;
  border: none;
  font-size: 24rpx;
  border-radius: 10rpx;
  padding: 0 20rpx;
  min-height: 52rpx;
  line-height: 52rpx;
}

.result-value {
  font-size: 30rpx;
  font-weight: 500;
  color: #1e293b;
}

.result-value.small {
  font-size: 24rpx;
  word-break: break-all;
}

.tip {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.6;
}

/* Class list */
.class-list {
  margin-bottom: 16rpx;
}

/* Pagination overrides */
.pagination {
  margin-top: 12rpx;
}

.pager-btn {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  height: 64rpx !important;
  line-height: 64rpx !important;
  padding: 0 24rpx !important;
}

.page-info {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  color: #64748b;
}

/* Class item card */
.class-item {
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 20rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.class-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.class-meta {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 10rpx;
}

.class-meta text {
  margin-right: 24rpx;
}

.class-codes {
  font-size: 24rpx;
  color: #94a3b8;
}

.code-label {
  display: block;
  margin-top: 4rpx;
}

/* Empty */
.empty-tip {
  text-align: center;
  color: #94a3b8;
  padding: 48rpx;
  font-size: 28rpx;
}

/* Task manage card */
.task-manage-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.task-manage-title {
  font-size: 30rpx;
  color: #1e293b;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.task-manage-desc {
  font-size: 25rpx;
  color: #64748b;
  line-height: 1.7;
}

.task-manage-link {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #3b82f6;
  font-weight: 600;
}

/* Secondary button */
.btn-secondary {
  margin-top: 24rpx;
  background: #fff;
  color: #3b82f6;
  border: 2rpx solid #3b82f6;
  border-radius: 14rpx;
  padding: 22rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-secondary:active {
  background: #eff6ff;
}
