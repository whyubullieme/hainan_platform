/* pages/auth/joinClass/joinClass.wxss */
.join-class-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 60rpx;
  box-sizing: border-box;
}

.join-class-header {
  text-align: center;
  margin-bottom: 120rpx;
}

.join-class-title {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 24rpx;
}

.join-class-subtitle {
  display: block;
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.9);
}

.join-class-form {
  width: 100%;
  max-width: 600rpx;
}

.input-group {
  margin-bottom: 48rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.input-field {
  width: 100%;
  height: 80rpx;
  padding: 0 32rpx;
  background-color: rgba(255, 255, 255, 0.95);
  border: none;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 80rpx;
  box-sizing: border-box;
  color: #333;
}

.join-btn {
  width: 100%;
  margin-top: 60rpx;
  background-color: #fff;
  color: #667eea;
  font-size: 36rpx;
  font-weight: bold;
  border-radius: 12rpx;
  padding: 32rpx;
}

.join-btn:active {
  background-color: rgba(255, 255, 255, 0.9);
}

.logout-wrap {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
}
.logout-link {
  color: rgba(255, 255, 255, 0.9);
}

