/**app.wxss — Global Design System**/

/* ===== Base ===== */
page {
  background: #f0f4f8;
  font-size: 28rpx;
  color: #1e293b;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.container {
  box-sizing: border-box;
}

/* ===== Color Tokens ===== */
.color-primary { color: #3b82f6; }
.color-success { color: #10b981; }
.color-warning { color: #f59e0b; }
.color-danger { color: #ef4444; }
.color-muted { color: #94a3b8; }

/* ===== Typography ===== */
.text-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
}
.text-subtitle {
  font-size: 28rpx;
  color: #64748b;
}
.text-muted {
  font-size: 24rpx;
  color: #94a3b8;
}

/* ===== Section ===== */
.section {
  margin: 28rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 20rpx;
}

/* ===== Cards ===== */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

/* ===== Buttons ===== */
.btn-primary {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important;
  color: #fff !important;
  border: none !important;
  border-radius: 14rpx !important;
  padding: 22rpx 40rpx !important;
  font-size: 28rpx !important;
  font-weight: 600;
}
.btn-primary:active {
  opacity: 0.9;
}

.btn-secondary {
  background: #fff !important;
  color: #334155 !important;
  border: 1rpx solid #e2e8f0 !important;
  border-radius: 14rpx !important;
  padding: 22rpx 40rpx !important;
  font-size: 28rpx !important;
}
.btn-secondary:active {
  background: #f8fafc !important;
}

/* ===== Inputs ===== */
.input-group {
  margin-bottom: 28rpx;
}
.input-label {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 10rpx;
  display: block;
}
.input-field {
  width: 100%;
  padding: 20rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #1e293b;
  box-sizing: border-box;
}

/* ===== Empty State ===== */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #94a3b8;
}
.empty-state-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}
.empty-state-text {
  font-size: 28rpx;
}

/* ===== Logout ===== */
.logout-wrap {
  display: flex;
  justify-content: flex-end;
  padding: 8rpx 0;
  margin-bottom: 8rpx;
}
.logout-link {
  font-size: 24rpx;
  color: #94a3b8;
}
.logout-link:active {
  color: #64748b;
}

/* ===== Tabs ===== */
.tabs,
.tab-bar,
.filter-tabs {
  display: flex;
  gap: 0;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 4rpx;
  overflow: hidden;
}
.tab-item,
.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 16rpx;
  border-radius: 12rpx;
  color: #64748b;
  font-size: 26rpx;
  font-weight: 500;
}
.tab-item.active,
.tab.active {
  background: #3b82f6;
  color: #fff;
  font-weight: 600;
}

/* ===== Pagination ===== */
.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 16rpx 0;
}
.page-btn {
  min-width: 120rpx;
  text-align: center;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  color: #334155;
  font-size: 24rpx;
}
.page-btn.disabled {
  opacity: 0.4;
}
.page-info {
  font-size: 24rpx;
  color: #94a3b8;
}

/* ===== Error ===== */
.error {
  color: #dc2626;
  font-size: 26rpx;
  background: #fef2f2;
  border: 1rpx solid #fecaca;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}
