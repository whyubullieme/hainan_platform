<!--pages/student/progress/progress.wxml-->
<view class="container">
  <view class="logout-wrap">
    <text class="logout-link" bindtap="handleLogout">退出登录</text>
  </view>

  <view class="section">
    <view class="section-title">学习进度</view>
    <view class="section-desc">各天签到与任务完成情况</view>
    <view class="progress-meta" wx:if="{{totalDays > 0}}">
      <text class="total-days">共 {{totalDays}} 天</text>
      <view class="pagination" wx:if="{{totalPages > 1}}">
        <text class="page-btn {{currentPage <= 1 ? 'disabled' : ''}}" bindtap="prevPage">上一页</text>
        <text class="page-info">第 {{currentPage}} / {{totalPages}} 页</text>
        <text class="page-btn {{currentPage >= totalPages ? 'disabled' : ''}}" bindtap="nextPage">下一页</text>
      </view>
    </view>

    <view class="progress-list" wx:if="{{visibleDays.length > 0}}">
      <view class="day-row {{item.completed ? 'completed' : ''}}" wx:for="{{visibleDays}}" wx:key="dayNumber">
        <view class="day-info">
          <text class="day-num">第 {{item.dayNumber}} 天</text>
          <text class="day-date">{{item.dateStr}}</text>
        </view>
        <view class="day-status">
          <text class="status-item {{item.checkedIn ? 'done' : ''}}">签到 {{item.checkedIn ? '✓' : '—'}}</text>
          <text class="status-item {{item.allSubmitted ? 'done' : ''}}">任务 {{item.submittedCount}}/{{item.taskCount}}</text>
        </view>
        <view class="complete-badge" wx:if="{{item.completed}}">已完成</view>
      </view>
    </view>

    <view class="empty-state" wx:elif="{{!loading}}">
      <text>暂无进度数据</text>
    </view>
  </view>
</view>
