/* pages/admin/classManage/classManage.wxss */
.container {
  min-height: 100vh;
  justify-content: flex-start;
  overflow-y: auto;
}

.section {
  padding: 32rpx;
  width: 100%;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 32rpx;
}

.form-row {
  margin-bottom: 32rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  padding: 24rpx;
  background: #fff;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.picker-value {
  padding: 24rpx;
  background: #fff;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 30rpx;
  color: #333;
}
.picker-value:active {
  background: #f5f5f5;
}

.btn-primary {
  margin-top: 48rpx;
  background-color: #667eea;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 28rpx;
}

.result-box {
  margin: 0 32rpx 48rpx;
  padding: 40rpx;
  background: #e8f4fd;
  border: 2rpx solid #1890ff;
  border-radius: 16rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 32rpx;
  color: #1890ff;
}

.result-item {
  margin-bottom: 32rpx;
}

.result-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.code-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #fff;
  border: 2rpx solid #1890ff;
  border-radius: 12rpx;
}

.code-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  letter-spacing: 4rpx;
}

.copy-btn {
  flex-shrink: 0;
  background-color: #1890ff;
  color: #fff;
  border: none;
  font-size: 26rpx;
}

.result-value {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.result-value.small {
  font-size: 24rpx;
  word-break: break-all;
}

.tip {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #999;
}
