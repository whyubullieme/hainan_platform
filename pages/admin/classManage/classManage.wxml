<!--pages/admin/classManage/classManage.wxml-->
<view class="container">
  <view class="logout-wrap">
    <text class="logout-link" bindtap="handleLogout">退出登录</text>
  </view>
  <view class="greeting-bar">
    <text class="greeting-text">{{greetingText}}</text>
  </view>

  <view class="section">
    <view class="section-title">班级列表</view>
    <view class="class-list" wx:if="{{visibleClasses.length > 0}}">
      <view
        class="card class-item"
        wx:for="{{visibleClasses}}"
        wx:key="_id"
        data-id="{{item._id}}"
        bindtap="goToDetail"
      >
        <view class="class-name">{{item.name}}</view>
        <view class="class-meta">
          <text>学生 {{item.studentCount}} 人</text>
          <text>教师 {{item.teacherCount}} 人</text>
          <text>{{item.startDate}}</text>
        </view>
        <view class="class-codes">
          <text class="code-label">学生码 {{item.studentInviteCode}}</text>
          <text class="code-label">教师码 {{item.teacherInviteCode}}</text>
        </view>
      </view>
      <pagination
        current-page="{{classCurrentPage}}"
        total-pages="{{classTotalPages}}"
        bind:change="onClassPageChange"
      />
    </view>
    <view class="empty-tip" wx:else>暂无班级</view>
  </view>

  <view class="section">
    <view class="section-title">任务管理</view>
    <view class="task-manage-card" bindtap="goToTaskManage">
      <view class="task-manage-title">题库管理</view>
      <view class="task-manage-desc">管理朗读、跟读、听力、对话任务模板</view>
      <view class="task-manage-link">进入题库管理 →</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">创建班级</view>
    <view class="form-row">
      <text class="label">班级名称</text>
      <input class="input" placeholder="请输入班级名称" value="{{className}}" bindinput="onClassNameInput" />
    </view>
    <view class="form-row">
      <text class="label">开始日期</text>
      <picker mode="date" value="{{startDate}}" start="{{minDate}}" bindchange="onStartDateChange">
        <view class="picker-value">{{startDate || '点击选择日期'}}</view>
      </picker>
    </view>
    <view class="form-row">
      <text class="label">课程天数</text>
      <picker
        mode="selector"
        range="{{daysOptions}}"
        value="{{daysIndex}}"
        bindchange="onTotalDaysPickerChange"
      >
        <view class="picker-value">{{totalDays}} 天</view>
      </picker>
    </view>
    <button class="btn-primary" bindtap="handleCreate" loading="{{loading}}" disabled="{{loading}}">
      创建班级并初始化任务
    </button>
  </view>

  <view class="result-box" wx:if="{{classId}}" id="resultBox">
    <view class="result-title">✓ 创建成功</view>
    <view class="result-item">
      <text class="result-label">学生邀请码（发给学生）</text>
      <view class="code-box">
        <text class="code-text">{{studentInviteCode || '—'}}</text>
        <button class="copy-btn" size="mini" data-code="{{studentInviteCode}}" bindtap="copyCode">复制</button>
      </view>
    </view>
    <view class="result-item">
      <text class="result-label">教师邀请码（发给教师）</text>
      <view class="code-box">
        <text class="code-text">{{teacherInviteCode || '—'}}</text>
        <button class="copy-btn" size="mini" data-code="{{teacherInviteCode}}" bindtap="copyCode">复制</button>
      </view>
    </view>
    <text class="tip">学生用学生码加入 → 学生端；教师用教师码加入 → 教师端</text>
    <button class="btn-secondary" bindtap="goToNewClass">查看班级详情</button>
  </view>
</view>
