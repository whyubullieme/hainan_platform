/**app.wxss**/

/* 尽量避免强侵入性的全局布局，页面容器在各自 .wxss 中定义 */
.container {
  box-sizing: border-box;
}

/* 全局样式（基础设计令牌） */
page {
  background-color: #f5f5f5;
  font-size: 32rpx;
  color: #333;
}

/* 颜色令牌 */
.color-primary { color: #07c160; }
.color-primary-strong { color: #06ad56; }
.color-accent { color: #667eea; }
.color-danger { color: #ff4d4f; }
.color-muted { color: #999; }

.bg-card { background-color: #fff; }
.bg-accent { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
.bg-primary { background: linear-gradient(135deg, #07c160 0%, #06ad56 100%); }

/* 文字与间距 */
.text-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.text-subtitle {
  font-size: 28rpx;
  color: #666;
}

.text-muted {
  font-size: 26rpx;
  color: #999;
}

.section {
  margin: 32rpx 30rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

/* 通用按钮样式 */
.btn-primary {
  background-color: #07c160;
  color: #fff;
  border-radius: 8rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  border: none;
}

.btn-primary:active {
  background-color: #06ad56;
}

.btn-secondary {
  background-color: #fff;
  color: #333;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
}

.btn-secondary:active {
  background-color: #f5f5f5;
}

/* 通用输入框样式 */
.input-group {
  margin-bottom: 32rpx;
}

.input-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.input-field {
  width: 100%;
  padding: 24rpx;
  background-color: #fff;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 32rpx;
  box-sizing: border-box;
}

/* 卡片样式 */
.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #999;
}

.empty-state-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-state-text {
  font-size: 28rpx;
}

/* 退出登录 */
.logout-wrap {
  padding: 24rpx 32rpx;
  text-align: right;
}
.logout-link {
  font-size: 26rpx;
  color: #999;
}
.logout-link:active {
  color: #666;
}

