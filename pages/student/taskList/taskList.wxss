/* pages/student/taskList/taskList.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx 32rpx 48rpx;
}

.list-meta {
  margin-bottom: 20rpx;
}

.meta-text {
  font-size: 26rpx;
  color: #8a93a2;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.task-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.task-card:active {
  opacity: 0.85;
}

.card-left {
  flex: 1;
  margin-right: 16rpx;
}

.task-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #1a2233;
  margin-bottom: 8rpx;
}

.task-meta {
  display: block;
  font-size: 24rpx;
  color: #8a93a2;
  margin-bottom: 6rpx;
}

.task-content {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.card-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
}

.status-badge {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.status-badge.done {
  background: #e8f5e9;
  color: #07c160;
}

.status-badge.pending {
  background: #f5f5f5;
  color: #aaa;
}

.arrow {
  font-size: 40rpx;
  color: #ccc;
  font-weight: 300;
}

.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #aaa;
}
