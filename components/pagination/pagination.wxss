/* Pagination Component */
.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0 12rpx;
}
.page-btn {
  font-size: 26rpx;
  color: #334155;
  padding: 12rpx 28rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 999rpx;
  background: #fff;
}
.page-btn.disabled {
  color: #cbd5e1;
  border-color: #f1f5f9;
  background: #f8fafc;
}
.page-info {
  font-size: 24rpx;
  color: #94a3b8;
  min-width: 80rpx;
  text-align: center;
}
