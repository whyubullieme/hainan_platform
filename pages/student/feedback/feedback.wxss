/* pages/student/feedback/feedback.wxss */
.container {
  min-height: 100vh;
  padding: 32rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}

.reviews-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.review-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.review-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.day-badge {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  background: #07c160;
  color: #fff;
  border-radius: 8rpx;
}

.teacher-name {
  font-size: 26rpx;
  color: #666;
}

.review-date {
  font-size: 24rpx;
  color: #6b7280;
}

.review-comment {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
}

.empty-state {
  text-align: center;
  padding: 80rpx;
  color: #999;
  font-size: 28rpx;
}
