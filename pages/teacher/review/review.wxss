.container {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.logout-wrap {
  display: flex;
  justify-content: flex-end;
}

.info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.submission-panel {
  background: #fff;
  border: 1rpx solid #e6edf7;
  border-radius: 14rpx;
  padding: 18rpx;
}

.submission-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 10rpx;
}

.submission-loading,
.submission-empty {
  font-size: 24rpx;
  color: #6b7280;
}

.task-progress {
  font-size: 24rpx;
  color: #4b5563;
  margin-bottom: 12rpx;
}

.task-progress-ok {
  color: #059669;
}

.task-progress-warn {
  color: #d97706;
}

.submission-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.submission-item {
  border: 1rpx solid #edf2f7;
  border-radius: 10rpx;
  padding: 12rpx;
}

.sub-task {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #111827;
}

.sub-redo {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #b45309;
}

.sub-note {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #374151;
  line-height: 1.6;
}

.sub-ai-eval {
  margin-top: 10rpx;
  padding: 10rpx;
  background: #f8fafc;
  border-radius: 8rpx;
}

.ai-eval-row {
  font-size: 24rpx;
  margin-bottom: 6rpx;
}

.ai-eval-label {
  color: #6b7280;
  margin-right: 8rpx;
}

.ai-eval-value {
  color: #1f2937;
}

.ai-eval-value.pass {
  color: #059669;
}

.ai-eval-value.fail {
  color: #dc2626;
}

.ai-eval-asr {
  font-size: 22rpx;
  color: #4b5563;
  line-height: 1.5;
}

.ai-eval-tip {
  margin-top: 8rpx;
}

.ai-eval-word {
  display: inline-block;
  margin-right: 12rpx;
  font-size: 22rpx;
  color: #c2410c;
}

.sub-ai-pending {
  margin-top: 8rpx;
}

.ai-eval-status {
  font-size: 24rpx;
  color: #1890ff;
}

.sub-audio {
  margin-top: 8rpx;
}

.sub-audio-name {
  display: block;
  font-size: 24rpx;
  color: #2563eb;
  margin-bottom: 8rpx;
}

.sub-audio-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.btn-audio-play {
  background: #eef6ff;
  color: #1677ff;
  border: 1rpx solid #bfdbfe;
}

.btn-audio-stop {
  background: #fff1f0;
  color: #cf1322;
  border: 1rpx solid #ffccc7;
}

.comment {
  min-height: 240rpx;
  border: 1px solid #ddd;
  border-radius: 16rpx;
  padding: 16rpx;
}

.error {
  color: #ff4d4f;
}

.action-row {
  display: flex;
  gap: 16rpx;
}

.btn-return,
.btn-save {
  flex: 1;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx;
}

.btn-save {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  color: #fff;
}

.btn-return {
  background: linear-gradient(135deg, #fa8c16 0%, #d97706 100%);
  color: #fff;
}
