<view class="container">
  <view class="logout-wrap">
    <text class="logout-link" bindtap="handleLogout">退出登录</text>
  </view>
  <view class="greeting-bar">
    <text class="greeting-text">{{greetingText}}</text>
  </view>

  <view class="controls">
    <view class="input-group">
      <text class="label">查看日期</text>
      <picker mode="date" value="{{date}}" bindchange="handleDateChange">
        <view class="day-input">
          {{date || '请选择日期'}}
        </view>
      </picker>
      <text class="label">（第 {{dayNumber}} 天）</text>
    </view>
    <button size="mini" bindtap="handleRefresh" loading="{{loading}}">刷新概览</button>
  </view>

  <view class="error" wx:if="{{error}}">{{error}}</view>

  <view class="overview" wx:if="{{overview}}">
    <view class="stat-card">
      <text class="stat-label">班级总人数</text>
      <text class="stat-value">{{overview.totalStudents || 0}}</text>
    </view>
    <view class="stat-card">
      <text class="stat-label">已签到</text>
      <text class="stat-value">{{overview.checkedInCount || 0}}</text>
    </view>
    <view class="stat-card">
      <text class="stat-label">已提交</text>
      <text class="stat-value">{{overview.submittedCount || 0}}</text>
    </view>
    <view class="stat-card">
      <text class="stat-label">已点评</text>
      <text class="stat-value">{{overview.reviewedCount || 0}}</text>
    </view>
  </view>

  <view class="actions">
    <button class="btn-missing" bindtap="handleViewMissing">未提交 {{missingCount}} 人</button>
    <button class="btn-done" bindtap="handleViewDone">待点评 {{pendingReviewCount}} 人</button>
    <button class="btn-reviewed" bindtap="handleViewReviewed">已点评 {{overview.reviewedCount || 0}} 人</button>
  </view>

  <view class="add-task-section">
    <view class="task-date-row">
      <text class="task-date-label">任务操作日期</text>
      <picker mode="date" value="{{taskActionDate}}" bindchange="handleTaskActionDateChange">
        <view class="task-date-picker">{{taskActionDate || '请选择日期'}}</view>
      </picker>
    </view>
    <view class="add-task-row">
      <button class="add-task-btn" bindtap="handleAddDayTasks">
        + 为该日期添加任务
      </button>
      <button class="revoke-task-btn" bindtap="handleRevokeDayTasks">
        撤销该日期任务
      </button>
    </view>
    <text class="add-task-tip">
      添加或撤销任务都以“任务操作日期”为准。
    </text>
  </view>
</view>
