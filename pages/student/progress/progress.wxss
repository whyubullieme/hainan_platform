/* pages/student/progress/progress.wxss */
.container {
  min-height: 100vh;
  padding: 32rpx;
  background: #f8f9fa;
}

.logout-wrap {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 24rpx;
}

.logout-link {
  font-size: 26rpx;
  color: #999;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.section-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.progress-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.total-days {
  font-size: 28rpx;
  color: #07c160;
  font-weight: 500;
}

.pagination {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.page-btn {
  font-size: 26rpx;
  color: #07c160;
}

.page-btn.disabled {
  color: #ccc;
}

.page-info {
  font-size: 24rpx;
  color: #666;
}

.progress-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.day-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.day-row.completed {
  background: #f0f9eb;
  border-left: 4rpx solid #52c41a;
}

.day-info {
  display: flex;
  flex-direction: column;
}

.day-num {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.day-date {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.day-status {
  display: flex;
  gap: 24rpx;
}

.status-item {
  font-size: 24rpx;
  color: #999;
}

.status-item.done {
  color: #52c41a;
}

.complete-badge {
  font-size: 24rpx;
  color: #52c41a;
  font-weight: 500;
}

.empty-state {
  text-align: center;
  padding: 80rpx;
  color: #999;
  font-size: 28rpx;
}
