/* pages/admin/classManage/classManage.wxss */
.container {
  min-height: 100vh;
  justify-content: flex-start;
  overflow-y: auto;
}

.section {
  padding: 32rpx;
  width: 100%;
}

.greeting-bar {
  margin: 0 32rpx 8rpx;
  padding: 14rpx 18rpx;
  background: #fff;
  border: 1rpx solid #e6edf7;
  border-radius: 12rpx;
}

.greeting-text {
  font-size: 26rpx;
  color: #334155;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 32rpx;
}

.form-row {
  margin-bottom: 32rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: #fff;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 30rpx;
  line-height: 80rpx;
  box-sizing: border-box;
  color: #333;
}

.picker-value {
  padding: 24rpx;
  background: #fff;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 30rpx;
  color: #333;
}
.picker-value:active {
  background: #f5f5f5;
}

.btn-primary {
  margin-top: 48rpx;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 28rpx;
}

.result-box {
  margin: 0 32rpx 48rpx;
  padding: 40rpx;
  background: #e8f4fd;
  border: 2rpx solid #1890ff;
  border-radius: 16rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 32rpx;
  color: #1890ff;
}

.result-item {
  margin-bottom: 32rpx;
}

.result-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.code-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #fff;
  border: 2rpx solid #1890ff;
  border-radius: 12rpx;
}

.code-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  letter-spacing: 4rpx;
}

.copy-btn {
  flex-shrink: 0;
  background-color: #1890ff;
  color: #fff;
  border: none;
  font-size: 26rpx;
}

.result-value {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.result-value.small {
  font-size: 24rpx;
  word-break: break-all;
}

.tip {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #999;
}

.class-list {
  margin-bottom: 32rpx;
}

.pagination {
  margin-top: 8rpx;
}

.pager-btn {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  height: 64rpx !important;
  line-height: 64rpx !important;
  padding: 0 24rpx !important;
}

.page-info {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  line-height: 64rpx;
}

.class-item {
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.class-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.class-meta {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.class-meta text {
  margin-right: 24rpx;
}

.class-codes {
  font-size: 24rpx;
  color: #999;
}

.code-label {
  display: block;
  margin-top: 4rpx;
}

.empty-tip {
  text-align: center;
  color: #999;
  padding: 48rpx;
  font-size: 28rpx;
}

.task-manage-card {
  background: #fff;
  border: 1rpx solid #e6edf7;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 16rpx rgba(15, 23, 42, 0.04);
}

.task-manage-title {
  font-size: 30rpx;
  color: #111827;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.task-manage-desc {
  font-size: 25rpx;
  color: #6b7280;
  line-height: 1.7;
}

.task-manage-link {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #07c160;
  font-weight: 600;
}

.btn-secondary {
  margin-top: 24rpx;
  background: #f0f0f0;
  color: #333;
}
