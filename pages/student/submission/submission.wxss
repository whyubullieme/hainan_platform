/* pages/student/submission/submission.wxss */

.container {
  min-height: 100vh;
  background: #f0f4f8;
  padding: 24rpx 28rpx 60rpx;
}

.section {
  padding: 0;
}
.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 24rpx;
}

/* Date picker */
.date-picker-row {
  margin-bottom: 24rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}
.date-label {
  display: block;
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 12rpx;
}
.picker-value {
  padding: 18rpx 24rpx;
  background: #f8fafc;
  border-radius: 14rpx;
  border: 1rpx solid #e2e8f0;
  font-size: 28rpx;
  color: #334155;
  font-weight: 500;
}

/* Filter tabs */
.filter-tabs {
  margin-top: 16rpx;
  background: #f1f5f9;
  border: none;
  border-radius: 14rpx;
  padding: 4rpx;
}
.tab {
  min-height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #64748b;
}
.tab.active {
  background: #3b82f6;
  color: #fff;
  font-weight: 600;
}

/* Records */
.records-list {
  margin-top: 8rpx;
}
.record-group {
  margin-bottom: 20rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}
.group-date {
  font-size: 24rpx;
  color: #64748b;
  font-weight: 600;
  margin-bottom: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}
.record-item:last-child {
  border-bottom: none;
}
.record-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}
.record-item .task-title {
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 600;
}
.record-meta {
  font-size: 22rpx;
  color: #94a3b8;
}
.record-redo-comment {
  font-size: 22rpx;
  color: #f59e0b;
  background: #fffbeb;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  margin-top: 4rpx;
}

/* Evaluation */
.record-eval {
  margin-top: 6rpx;
}
.eval-status-text {
  font-size: 24rpx;
  color: #3b82f6;
}
.eval-status-text.failed {
  color: #ef4444;
}
.eval-score-text {
  font-size: 24rpx;
  color: #10b981;
  font-weight: 600;
}
.submitted-at {
  font-size: 24rpx;
  color: #10b981;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.submitted-at.redo {
  color: #f59e0b;
}

/* Empty */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #94a3b8;
  font-size: 28rpx;
}
