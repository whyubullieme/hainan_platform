/**app.wxss**/

/* 尽量避免强侵入性的全局布局，页面容器在各自 .wxss 中定义 */
.container {
  box-sizing: border-box;
}

/* 全局样式（基础设计令牌） */
page {
  background: linear-gradient(180deg, #f7f9fc 0%, #f3f6fb 100%);
  font-size: 32rpx;
  color: #1f2937;
}

/* 颜色令牌 */
.color-primary { color: #07c160; }
.color-primary-strong { color: #06ad56; }
.color-accent { color: #667eea; }
.color-danger { color: #ff4d4f; }
.color-muted { color: #999; }

.bg-card { background-color: #fff; }
.bg-accent { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
.bg-primary { background: linear-gradient(135deg, #07c160 0%, #06ad56 100%); }

/* 文字与间距 */
.text-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.text-subtitle {
  font-size: 28rpx;
  color: #666;
}

.text-muted {
  font-size: 26rpx;
  color: #999;
}

.section {
  margin: 32rpx 30rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

/* 通用按钮样式 */
.btn-primary {
  background-color: #07c160;
  color: #fff;
  border-radius: 8rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  border: none;
}

.btn-primary:active {
  background-color: #06ad56;
}

.btn-secondary {
  background-color: #fff;
  color: #333;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
}

.btn-secondary:active {
  background-color: #f5f5f5;
}

/* 通用输入框样式 */
.input-group {
  margin-bottom: 32rpx;
}

.input-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.input-field {
  width: 100%;
  padding: 24rpx;
  background-color: #fff;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 32rpx;
  box-sizing: border-box;
}

/* 卡片样式 */
.card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin: 24rpx;
  border: 1rpx solid #e9eef7;
  box-shadow: 0 10rpx 24rpx rgba(31, 41, 55, 0.06);
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #999;
}

.empty-state-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-state-text {
  font-size: 28rpx;
}

/* 退出登录 */
.logout-wrap {
  padding: 24rpx 32rpx;
  text-align: right;
}
.logout-link {
  font-size: 26rpx;
  color: #999;
}
.logout-link:active {
  color: #666;
}

/* 通用栏位与分段控件 */
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 22rpx;
  background: #fff;
  border: 1rpx solid #e6edf7;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 14rpx rgba(30, 41, 59, 0.05);
}

.tabs,
.tab-bar,
.filter-tabs {
  display: flex;
  gap: 10rpx;
  padding: 8rpx;
  background: #edf2f9;
  border: 1rpx solid #dbe5f3;
  border-radius: 18rpx;
}

.tab-item,
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  color: #5b6472;
  font-size: 27rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.tab-item.active,
.tab.active {
  background: #fff;
  color: #14532d;
  font-weight: 700;
  box-shadow: 0 6rpx 14rpx rgba(15, 23, 42, 0.08);
}

.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  margin-top: 20rpx;
}

.page-btn {
  min-width: 116rpx;
  text-align: center;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #d7e0ec;
  color: #374151;
  font-size: 24rpx;
}

.page-btn.disabled {
  opacity: 0.45;
}

.page-info {
  font-size: 24rpx;
  color: #6b7280;
}
