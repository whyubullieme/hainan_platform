/* pages/student/home/home.wxss */
.home-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

.demo-banner {
  background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
  padding: 24rpx;
  text-align: center;
}

.demo-text {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.date-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 40rpx;
  color: #fff;
}

.day-info {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 20rpx;
}

.day-label {
  font-size: 32rpx;
  margin: 0 8rpx;
}

.day-number {
  font-size: 80rpx;
  font-weight: bold;
  margin: 0 16rpx;
}

.date-text {
  display: block;
  text-align: center;
  font-size: 28rpx;
  opacity: 0.9;
}

.checkin-header-btn {
  margin-top: 24rpx;
  background-color: rgba(255,255,255,0.3);
  color: #fff;
  border: 1rpx solid rgba(255,255,255,0.6);
}

.checked-badge {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: rgba(255,255,255,0.95);
}

.task-desc {
  font-size: 26rpx;
  color: #999;
}

.submit-btn {
  background-color: #07c160;
  color: #fff;
}

.task-section {
  margin: 40rpx 30rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.task-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.task-content {
  flex: 1;
}

.task-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.task-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-right: 16rpx;
}

.task-status {
  font-size: 24rpx;
  color: #07c160;
  padding: 4rpx 12rpx;
  background-color: #e8f5e9;
  border-radius: 8rpx;
}

.task-status.pending {
  color: #ff9800;
  background-color: #fff3e0;
}

.task-scenario {
  font-size: 26rpx;
  color: #999;
}

.task-actions {
  margin-left: 24rpx;
}

.action-btn {
  background-color: #667eea;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}

.action-btn:active {
  background-color: #5568d3;
}

.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.quick-actions {
  margin: 40rpx 30rpx;
}

.action-button {
  width: 100%;
  background-color: #07c160;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.action-button:active {
  background-color: #06ad56;
}

.action-button.primary {
  background-color: #667eea;
}

.action-button.primary:active {
  background-color: #5568d3;
}
