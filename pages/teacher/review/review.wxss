.container {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.logout-wrap {
  display: flex;
  justify-content: flex-end;
}

.info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.comment {
  min-height: 240rpx;
  border: 1px solid #ddd;
  border-radius: 16rpx;
  padding: 16rpx;
}

.error {
  color: #ff4d4f;
}

.btn-save {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx;
}
