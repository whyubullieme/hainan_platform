/* pages/student/myTasks/myTasks.wxss */

.container {
  min-height: 100vh;
  background: #f0f4f8;
  padding: 0 28rpx 48rpx;
}

/* Tab bar */
.tab-bar {
  display: flex;
  background: #fff;
  margin: 0 -28rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid #e2e8f0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: #94a3b8;
  position: relative;
  font-weight: 500;
  transition: color 0.2s ease;
}

.tab-item.tab-active {
  color: #1e293b;
  font-weight: 700;
}

.tab-item.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #3b82f6;
  border-radius: 3rpx;
}

/* Section title */
.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
  margin: 32rpx 0 24rpx;
}

/* Type grid */
.type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.type-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 48rpx 24rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
  border: 1rpx solid #e2e8f0;
  transition: transform 0.15s ease;
}

.type-card:active {
  transform: scale(0.97);
  opacity: 0.88;
}

.type-icon {
  font-size: 64rpx;
  margin-bottom: 4rpx;
}

.type-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.type-desc {
  font-size: 24rpx;
  color: #94a3b8;
  text-align: center;
  line-height: 1.4;
}

/* Dialogue history - loading / error / empty */
.loading-hint,
.error-hint,
.empty-hint {
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: #94a3b8;
}

.error-hint {
  color: #ef4444;
}

/* Dialogue list */
.dialogue-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.dialogue-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
  border: 1rpx solid #e2e8f0;
}

.dialogue-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.dialogue-scene-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Badge */
.badge {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
  font-weight: 500;
}

.badge-pass {
  background: rgba(16, 185, 129, 0.1);
  color: #10b981;
  border: none;
}

.badge-fail {
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
  border: none;
}

/* Dialogue card body */
.dialogue-card-body {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 32rpx;
}

.dialogue-info-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dialogue-label {
  font-size: 24rpx;
  color: #94a3b8;
}

.dialogue-value {
  font-size: 26rpx;
  color: #1e293b;
}

.dialogue-score {
  font-weight: 700;
  color: #3b82f6;
}
