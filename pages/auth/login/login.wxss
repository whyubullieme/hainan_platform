/* pages/auth/login/login.wxss */

.login-container {
  min-height: 100vh;
  background: linear-gradient(160deg, #1e3a5f 0%, #3b82f6 50%, #60a5fa 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 60rpx;
  box-sizing: border-box;
}

.login-header {
  text-align: center;
  margin-bottom: 100rpx;
}
.login-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}
.login-subtitle {
  display: block;
  font-size: 34rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 400;
}

.login-form {
  width: 100%;
  max-width: 600rpx;
}

.input-group {
  margin-bottom: 36rpx;
}
.input-label {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 12rpx;
  font-weight: 500;
}
.input-field {
  width: 100%;
  height: 88rpx;
  padding: 0 32rpx;
  background: rgba(255, 255, 255, 0.95);
  border: none;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 88rpx;
  box-sizing: border-box;
  color: #1e293b;
}

.login-btn {
  width: 100%;
  margin-top: 48rpx;
  background: #fff !important;
  color: #3b82f6 !important;
  font-size: 34rpx !important;
  font-weight: 700;
  border-radius: 16rpx !important;
  padding: 28rpx !important;
  border: none !important;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}
.login-btn:active {
  opacity: 0.92;
}

.login-tip {
  margin-top: 36rpx;
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.6;
}

.admin-entry {
  margin-top: 48rpx;
  text-align: center;
}
.admin-link {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  text-decoration: underline;
}
.admin-link:active {
  color: rgba(255, 255, 255, 0.9);
}

.quick-access {
  margin-top: 60rpx;
  text-align: center;
}
.quick-access-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 24rpx;
}
.quick-btn {
  width: 100%;
  background: transparent !important;
  color: rgba(255, 255, 255, 0.85) !important;
  font-size: 28rpx !important;
  border: 1rpx solid rgba(255, 255, 255, 0.3) !important;
  border-radius: 16rpx !important;
  padding: 24rpx !important;
}
.quick-btn:active {
  background: rgba(255, 255, 255, 0.1) !important;
}
