/* pages/student/taskDetail/taskDetail.wxss */
.container {
  min-height: 100vh;
  padding: 32rpx;
  background: #f8f9fa;
}

.logout-wrap {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 24rpx;
}

.logout-link {
  font-size: 26rpx;
  color: #999;
}

.task-detail {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.task-type-badge {
  display: inline-block;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
}

.task-type-badge.read-along {
  background: #e8f4fd;
  color: #1890ff;
}

.task-type-badge.read-aloud {
  background: #f0f9eb;
  color: #52c41a;
}

.task-header {
  margin-bottom: 24rpx;
}

.task-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
}

.task-day {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.task-content {
  padding: 24rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.content-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
}

.task-tip {
  padding: 24rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.task-tip text {
  font-size: 26rpx;
  color: #999;
}

.task-actions {
  margin-top: 48rpx;
}

.submit-box {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 24rpx;
}

.submit-label {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 10rpx;
}

.devtools-tip {
  display: block;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: #d97706;
}

.submit-note {
  width: 100%;
  min-height: 160rpx;
  border: 1rpx solid #dbe3ef;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  margin-bottom: 18rpx;
}

.audio-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.btn-audio {
  background: #eef6ff;
  color: #1677ff;
  border: 1rpx solid #bfdbfe;
}

.btn-audio-preview {
  background: #f0fdf4;
  color: #15803d;
  border: 1rpx solid #bbf7d0;
}

.btn-audio-file {
  background: #fff7ed;
  color: #c2410c;
  border: 1rpx solid #fed7aa;
}

.btn-clear-audio {
  background: #fff1f0;
  color: #cf1322;
  border: 1rpx solid #ffccc7;
}

.audio-name {
  display: block;
  font-size: 24rpx;
  color: #4b5563;
  margin: 10rpx 0 18rpx;
}

.btn-submit {
  width: 100%;
  background: #07c160;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 28rpx;
  font-size: 32rpx;
}

.task-submitted {
  margin-top: 32rpx;
}

.submitted-badge {
  font-size: 28rpx;
  color: #07c160;
}

.loading-state,
.empty-state {
  text-align: center;
  padding: 80rpx;
  color: #999;
  font-size: 28rpx;
}
