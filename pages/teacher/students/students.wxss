.container {
  padding: 24rpx;
}

.logout-wrap {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 24rpx;
}

.tab-bar {
  margin-bottom: 24rpx;
}

.tab-item {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-item.active {
  color: #14532d;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  background: #fff;
  border: 1rpx solid #e6edf7;
  border-radius: 14rpx;
  padding: 12rpx 18rpx;
}

.error {
  color: #ff4d4f;
  margin-bottom: 16rpx;
}

.empty {
  text-align: center;
  color: #888;
  margin-top: 40rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.student-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #e6edf7;
  box-shadow: 0 8rpx 16rpx rgba(15, 23, 42, 0.05);
}

.student-info {
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.meta {
  color: #6b7280;
  font-size: 24rpx;
}

.btn-review {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  color: #fff;
  border: none;
  border-radius: 999rpx;
  padding: 0 22rpx;
}
