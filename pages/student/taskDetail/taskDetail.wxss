/* pages/student/taskDetail/taskDetail.wxss */
.container {
  min-height: 100vh;
  padding: 32rpx;
  background: #f8f9fa;
}

.logout-wrap {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 24rpx;
}

.logout-link {
  font-size: 26rpx;
  color: #999;
}

.task-detail {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.task-type-badge {
  display: inline-block;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
}

.task-type-badge.read-along {
  background: #e8f4fd;
  color: #1890ff;
}

.task-type-badge.read-aloud {
  background: #f0f9eb;
  color: #52c41a;
}

.task-type-badge.listening-mcq {
  background: #fff7ed;
  color: #c2410c;
}

.task-header {
  margin-bottom: 24rpx;
}

.task-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
}

.task-day {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.task-content {
  padding: 24rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.content-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
}

.task-tip {
  padding: 24rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.task-tip text {
  font-size: 26rpx;
  color: #999;
}

.task-actions {
  margin-top: 48rpx;
}

.submit-box {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 24rpx;
}

.redo-alert {
  margin-bottom: 18rpx;
  padding: 16rpx;
  border: 1rpx solid #fdba74;
  border-radius: 12rpx;
  background: #fff7ed;
}

.redo-alert-title {
  display: block;
  font-size: 25rpx;
  color: #b45309;
  font-weight: 600;
}

.redo-alert-text {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #92400e;
  line-height: 1.5;
}

.submit-label {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 10rpx;
}

.devtools-tip {
  display: block;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: #d97706;
}

.submit-note {
  width: 100%;
  min-height: 160rpx;
  border: 1rpx solid #dbe3ef;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  margin-bottom: 18rpx;
}

.answer-label {
  margin-top: 20rpx;
}

.option-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 16rpx 14rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #fff;
}

.option-text {
  flex: 1;
  font-size: 27rpx;
  color: #1f2937;
  line-height: 1.5;
}

.btn-prompt-audio {
  background: #fff7ed;
  color: #c2410c;
  border: 1rpx solid #fdba74;
}

.prompt-text-tip {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.prompt-text-box {
  margin-top: 10rpx;
  margin-bottom: 8rpx;
  padding: 14rpx;
  border-radius: 12rpx;
  border: 1rpx solid #e5e7eb;
  background: #f9fafb;
}

.prompt-text {
  font-size: 28rpx;
  color: #111827;
  line-height: 1.5;
}

.session-progress {
  display: block;
  font-size: 28rpx;
  color: #111827;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.session-tip {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 14rpx;
}

.session-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
}

.btn-nav {
  background: #f3f4f6;
  color: #374151;
  border: 1rpx solid #d1d5db;
}

.session-answered {
  display: block;
  margin-top: 14rpx;
  margin-bottom: 18rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.session-result {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.result-title {
  display: block;
  font-size: 32rpx;
  color: #111827;
  font-weight: 600;
}

.result-score {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #065f46;
}

.result-list {
  margin-top: 18rpx;
}

.result-item {
  padding: 14rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #fafafa;
}

.result-item-title {
  display: block;
  font-size: 26rpx;
  color: #111827;
  font-weight: 600;
}

.result-item-line {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #374151;
}

.result-item-line.correct {
  color: #065f46;
}

.audio-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.btn-audio {
  background: #eef6ff;
  color: #1677ff;
  border: 1rpx solid #bfdbfe;
}

.btn-audio-preview {
  background: #f0fdf4;
  color: #15803d;
  border: 1rpx solid #bbf7d0;
}

.btn-audio-file {
  background: #fff7ed;
  color: #c2410c;
  border: 1rpx solid #fed7aa;
}

.btn-clear-audio {
  background: #fff1f0;
  color: #cf1322;
  border: 1rpx solid #ffccc7;
}

.audio-name {
  display: block;
  font-size: 24rpx;
  color: #4b5563;
  margin: 10rpx 0 18rpx;
}

.btn-submit {
  width: 100%;
  background: #07c160;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 28rpx;
  font-size: 32rpx;
}

.task-submitted {
  margin-top: 32rpx;
}

.submitted-badge {
  font-size: 28rpx;
  color: #07c160;
}

.evaluation-section {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.eval-status {
  font-size: 26rpx;
  color: #1890ff;
}

.eval-status.eval-failed {
  color: #cf1322;
}

.eval-result {
  margin-top: 12rpx;
}

.eval-row {
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.eval-row.eval-total {
  font-weight: 600;
  margin-top: 16rpx;
}

.eval-label {
  color: #6b7280;
  margin-right: 8rpx;
}

.eval-value {
  color: #1a1a1a;
}

.eval-value.pass {
  color: #07c160;
}

.eval-value.fail {
  color: #cf1322;
}

.eval-score {
  font-size: 24rpx;
  color: #6b7280;
}

.eval-tip {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #e5e7eb;
}

.eval-word-error {
  display: inline-block;
  margin-right: 12rpx;
  font-size: 24rpx;
  color: #c2410c;
}

.loading-state,
.empty-state {
  text-align: center;
  padding: 80rpx;
  color: #999;
  font-size: 28rpx;
}
