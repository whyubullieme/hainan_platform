/* pages/teacher/addTask/addTask.wxss */

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
  background: #f0f4f8;
}

.header {
  margin-bottom: 28rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 10rpx;
  letter-spacing: 0.5rpx;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: #94a3b8;
  line-height: 1.5;
}

.assign-date-box {
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.assign-date-label {
  display: block;
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 10rpx;
}

.assign-date-value {
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  color: #1e293b;
  background: #f8fafc;
  font-size: 28rpx;
}

.tabs {
  margin-bottom: 20rpx;
}

.error {
  color: #dc2626;
  background: #fef2f2;
  border: 1rpx solid #fecaca;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.loading {
  padding: 60rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 28rpx;
}

.empty-text {
  display: block;
  text-align: center;
  padding: 60rpx 0;
  color: #94a3b8;
  font-size: 28rpx;
}

.task-list {
  flex: 1;
  height: 60vh;
  margin-bottom: 24rpx;
}

.task-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
  transition: all 0.2s ease;
}

.task-item.selected {
  border-color: #10b981;
  background: #f0fdf4;
  box-shadow: 0 2rpx 16rpx rgba(16, 185, 129, 0.1);
}

.task-check {
  width: 48rpx;
  height: 48rpx;
  margin-right: 24rpx;
  border: 2rpx solid #cbd5e1;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.task-item.selected .task-check {
  background: #10b981;
  border-color: #10b981;
}

.task-body {
  flex: 1;
  min-width: 0;
}

.task-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.task-desc {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 6rpx;
  line-height: 1.5;
}

.task-type {
  font-size: 22rpx;
  color: #059669;
  font-weight: 600;
}

.footer {
  padding-top: 16rpx;
}

.pagination {
  margin-bottom: 8rpx;
}

.btn-page {
  background: #fff !important;
  color: #1e293b !important;
  border: 1rpx solid #e2e8f0 !important;
  border-radius: 999rpx !important;
  padding: 0 20rpx !important;
}

.btn-confirm {
  width: 100%;
  background: linear-gradient(135deg, #10b981, #059669);
  color: #fff;
  border: none;
  border-radius: 14rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.25);
  letter-spacing: 1rpx;
}

.btn-confirm[disabled] {
  opacity: 0.6;
}

.btn-back {
  width: 100%;
  background: #fff;
  color: #64748b;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-back:active {
  background: #f8fafc;
}
