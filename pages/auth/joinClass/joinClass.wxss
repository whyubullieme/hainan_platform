/* pages/auth/joinClass/joinClass.wxss */

.join-class-container {
  min-height: 100vh;
  background: linear-gradient(160deg, #1e3a5f 0%, #3b82f6 50%, #60a5fa 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 60rpx;
  box-sizing: border-box;
}

.join-class-header {
  text-align: center;
  margin-bottom: 80rpx;
}
.join-class-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}
.join-class-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.join-class-form {
  width: 100%;
  max-width: 600rpx;
}

.input-group {
  margin-bottom: 36rpx;
}
.input-label {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 12rpx;
  font-weight: 500;
}
.input-field {
  width: 100%;
  height: 88rpx;
  padding: 0 32rpx;
  background: rgba(255, 255, 255, 0.95);
  border: none;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 88rpx;
  box-sizing: border-box;
  color: #1e293b;
}

.join-btn {
  width: 100%;
  margin-top: 48rpx;
  background: #fff !important;
  color: #3b82f6 !important;
  font-size: 34rpx !important;
  font-weight: 700;
  border-radius: 16rpx !important;
  padding: 28rpx !important;
  border: none !important;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}
.join-btn:active {
  opacity: 0.92;
}

.logout-wrap {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
}
.logout-link {
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
}
