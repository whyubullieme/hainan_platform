/* pages/auth/login/login.wxss */
.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 60rpx;
  box-sizing: border-box;
}

.login-header {
  text-align: center;
  margin-bottom: 120rpx;
}

.login-title {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 24rpx;
}

.login-subtitle {
  display: block;
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.9);
}

.login-form {
  width: 100%;
  max-width: 600rpx;
}

.input-group {
  margin-bottom: 48rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.input-field {
  width: 100%;
  padding: 28rpx 32rpx;
  background-color: rgba(255, 255, 255, 0.95);
  border: none;
  border-radius: 12rpx;
  font-size: 32rpx;
  box-sizing: border-box;
}

.login-btn {
  width: 100%;
  margin-top: 60rpx;
  background-color: #fff;
  color: #667eea;
  font-size: 36rpx;
  font-weight: bold;
  border-radius: 12rpx;
  padding: 32rpx;
}

.login-btn:active {
  background-color: rgba(255, 255, 255, 0.9);
}

.login-tip {
  margin-top: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.6;
}

.quick-access {
  margin-top: 60rpx;
  text-align: center;
}

.quick-access-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 24rpx;
}

.quick-btn {
  width: 100%;
  background-color: transparent;
  color: rgba(255, 255, 255, 0.9);
  font-size: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 12rpx;
  padding: 24rpx;
}

.quick-btn:active {
  background-color: rgba(255, 255, 255, 0.1);
}

.admin-entry {
  margin-top: 48rpx;
  text-align: center;
}

.admin-link {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  text-decoration: underline;
}

.admin-link:active {
  color: rgba(255, 255, 255, 0.9);
}

