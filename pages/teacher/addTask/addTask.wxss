/* pages/teacher/addTask/addTask.wxss */
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 24rpx;
}

.assign-date-box {
  background: #fff;
  border: 1rpx solid #e6edf7;
  border-radius: 16rpx;
  padding: 18rpx;
  margin-bottom: 18rpx;
}

.assign-date-label {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.assign-date-value {
  border: 1rpx solid #d7e0ec;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  color: #1f2937;
  background: #f8fbff;
}

.tabs {
  margin-bottom: 18rpx;
}

.title {
  display: block;
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: #999;
}

.error {
  color: #ff4d4f;
  margin-bottom: 16rpx;
}

.loading {
  padding: 60rpx;
  text-align: center;
  color: #999;
}

.task-list {
  flex: 1;
  height: 60vh;
  margin-bottom: 24rpx;
}

.task-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #e7eef8;
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.05);
}

.task-item.selected {
  border-color: #07c160;
  background: #f4fcf7;
}

.task-check {
  width: 48rpx;
  height: 48rpx;
  margin-right: 24rpx;
  border: 2rpx solid #cfd8e6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  flex-shrink: 0;
}

.task-item.selected .task-check {
  background: #07c160;
  border-color: #07c160;
}

.task-body {
  flex: 1;
  min-width: 0;
}

.task-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.task-desc {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 4rpx;
}

.task-type {
  font-size: 22rpx;
  color: #047857;
  font-weight: 600;
}

.footer {
  padding-top: 16rpx;
}

.pagination {
  margin-bottom: 8rpx;
}

.btn-page {
  background: #fff !important;
  color: #374151 !important;
  border: 1rpx solid #d7e0ec !important;
  border-radius: 999rpx !important;
  padding: 0 20rpx !important;
}

.btn-confirm {
  width: 100%;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 28rpx;
  font-size: 32rpx;
  margin-bottom: 16rpx;
}

.btn-back {
  width: 100%;
  background: #f5f5f5;
  color: #666;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
}
