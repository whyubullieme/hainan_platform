/* pages/admin/classDetail/classDetail.wxss */

.container {
  min-height: 100vh;
  background: #f0f4f8;
  padding-bottom: 48rpx;
}

/* Logout */
.logout-wrap {
  padding: 24rpx 28rpx 0;
  display: flex;
  justify-content: flex-end;
}

.logout-link {
  font-size: 24rpx;
  color: #94a3b8;
}

/* Section */
.section {
  margin: 16rpx 28rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.members-section {
  margin-top: 8rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 24rpx;
}

/* Tabs */
.tabs {
  display: flex;
  gap: 10rpx;
  padding: 8rpx;
  background: #e2e8f0;
  border-radius: 18rpx;
  margin-bottom: 16rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  color: #64748b;
  font-size: 27rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.tab-item.active {
  background: #fff;
  color: #1e293b;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.08);
}

.tab-desc {
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 20rpx;
}

/* Info rows */
.info-row {
  margin-bottom: 24rpx;
}

.info-label {
  display: block;
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.info-value {
  font-size: 30rpx;
  color: #1e293b;
  font-weight: 500;
}

.picker-value {
  font-size: 30rpx;
  color: #1e293b;
  padding: 16rpx 20rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
}

/* Input */
.input {
  padding: 16rpx 20rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  font-size: 30rpx;
  color: #1e293b;
}

/* Code row */
.code-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.code-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  letter-spacing: 2rpx;
}

.copy-btn {
  flex-shrink: 0;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #fff;
  border: none;
  border-radius: 10rpx;
  font-size: 24rpx;
  padding: 0 20rpx;
  min-height: 52rpx;
  line-height: 52rpx;
}

/* Button row */
.btn-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #10b981, #059669);
  color: #fff;
  border: none;
  border-radius: 14rpx;
  padding: 20rpx 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(16, 185, 129, 0.25);
}

.btn-secondary {
  background: #fff;
  color: #3b82f6;
  border: 2rpx solid #3b82f6;
  border-radius: 14rpx;
  padding: 20rpx 36rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-secondary:active {
  background: #eff6ff;
}

.btn-danger {
  background: #fff;
  color: #ef4444;
  border: 2rpx solid #ef4444;
  border-radius: 14rpx;
  padding: 20rpx 36rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-danger:active {
  background: #fef2f2;
}

/* Add member row */
.add-member-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  padding: 16rpx 20rpx;
  background: #f8fafc;
  border-radius: 14rpx;
  border: 1rpx solid #e2e8f0;
  font-size: 28rpx;
  color: #1e293b;
}

.btn-sm {
  padding: 16rpx 28rpx;
  font-size: 27rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #fff;
  border: none;
  border-radius: 14rpx;
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.2);
}

/* User picker */
.user-picker {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.picker-title {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.user-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
  font-size: 28rpx;
  color: #1e293b;
}

.user-item:last-child {
  border-bottom: none;
}

.user-item button {
  margin-left: 12rpx;
  font-size: 24rpx;
  border-radius: 10rpx;
}

/* Member list */
.member-list {
  margin-top: 16rpx;
}

.member-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 24rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  margin-bottom: 12rpx;
}

.member-info {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.member-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #1e293b;
}

.member-role {
  font-size: 23rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.member-role.student {
  background: #eff6ff;
  color: #3b82f6;
}

.member-role.teacher {
  background: #ecfdf5;
  color: #10b981;
}

/* Member actions */
.member-actions {
  display: flex;
  gap: 12rpx;
}

.btn-role {
  font-size: 23rpx;
  background: #fff;
  color: #64748b;
  border: 1rpx solid #e2e8f0;
  border-radius: 10rpx;
  padding: 0 16rpx;
  min-height: 52rpx;
  line-height: 52rpx;
}

.btn-remove {
  font-size: 23rpx;
  background: #fff;
  color: #ef4444;
  border: 1rpx solid #fecaca;
  border-radius: 10rpx;
  padding: 0 16rpx;
  min-height: 52rpx;
  line-height: 52rpx;
}

/* Empty */
.empty-tip {
  text-align: center;
  color: #94a3b8;
  padding: 48rpx;
  font-size: 28rpx;
}

/* Pagination */
.pagination {
  margin-top: 12rpx;
}
