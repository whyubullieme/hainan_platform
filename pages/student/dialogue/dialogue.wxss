/* pages/student/dialogue/dialogue.wxss */

/* ═══ Page ═══════════════════════════════════════════════════════════ */
.page {
  min-height: 100vh;
  background: #f0f4f8;
}

/* ═══ Loading screen ═════════════════════════════════════════════════ */
.loading-screen {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  background: #f0f4f8;
}

.loading-icon-wrap {
  width: 140rpx;
  height: 140rpx;
  background: #fff;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(59, 130, 246, 0.12);
  margin-bottom: 12rpx;
}

.loading-icon { font-size: 72rpx; }
.loading-title { font-size: 32rpx; font-weight: 700; color: #1e293b; }
.loading-sub { font-size: 26rpx; color: #94a3b8; }

.loading-dots { display: flex; gap: 14rpx; margin-top: 12rpx; }
.ldot {
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: #3b82f6; animation: ldot-bounce 1.2s ease-in-out infinite;
}
.ldot-2 { animation-delay: 0.2s; }
.ldot-3 { animation-delay: 0.4s; }
@keyframes ldot-bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40%            { transform: scale(1.0); opacity: 1.0; }
}

/* ═══ Chat screen ════════════════════════════════════════════════════ */
.chat-screen { display: flex; flex-direction: column; min-height: 100vh; }

/* ─── Sticky header ─────────────────────────────────────────────── */
.chat-header {
  position: sticky; top: 0; z-index: 20;
  background: #fff;
  padding: 22rpx 28rpx 18rpx;
  border-bottom: 1rpx solid #e2e8f0;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.header-main {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 12rpx;
}
.header-scene-info { display: flex; align-items: center; gap: 14rpx; }
.header-scene-name { font-size: 32rpx; font-weight: 700; color: #1e293b; }
.header-level-tag {
  font-size: 22rpx; background: #dbeafe; color: #1d4ed8;
  padding: 4rpx 16rpx; border-radius: 20rpx; font-weight: 600;
}
.header-round-text { font-size: 26rpx; color: #3b82f6; font-weight: 600; }
.header-done-tag {
  font-size: 24rpx; background: #d1fae5; color: #065f46;
  padding: 6rpx 18rpx; border-radius: 20rpx; font-weight: 600;
}

.header-progress-dots { display: flex; align-items: center; gap: 10rpx; }
.rdot { width: 20rpx; height: 20rpx; border-radius: 50%; transition: all 0.3s; }
.rdot.done   { background: #3b82f6; }
.rdot.active { background: #93c5fd; box-shadow: 0 0 0 4rpx rgba(59, 130, 246, 0.2); }
.rdot.todo   { background: #e2e8f0; }
.header-role-hint { font-size: 22rpx; color: #94a3b8; margin-left: 10rpx; }

/* Gateway status indicator */
.header-ws-status {
  display: flex; align-items: center; gap: 8rpx; margin-top: 8rpx;
}
.ws-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
}
.ws-ok      { background: #10b981; }
.ws-pending { background: #f59e0b; animation: ws-blink 1s infinite; }
.ws-off     { background: #94a3b8; }
@keyframes ws-blink {
  0%, 100% { opacity: 1; }
  50%      { opacity: 0.3; }
}
.ws-label { font-size: 20rpx; color: #94a3b8; }

/* ─── Messages area ─────────────────────────────────────────────── */
.messages {
  flex: 1; padding: 24rpx 24rpx 0; padding-bottom: 320rpx;
  display: flex; flex-direction: column; gap: 4rpx;
}

/* Scene context card */
.scene-card {
  background: #fff; border-radius: 20rpx; padding: 28rpx 32rpx;
  margin-bottom: 28rpx; border-left: 6rpx solid #3b82f6;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}
.scene-card-top { display: flex; align-items: center; gap: 12rpx; margin-bottom: 14rpx; }
.scene-card-icon { font-size: 32rpx; }
.scene-card-label { font-size: 26rpx; font-weight: 700; color: #3b82f6; }
.scene-card-desc { font-size: 27rpx; color: #475569; line-height: 1.65; margin-bottom: 16rpx; }
.scene-card-tip {
  display: flex; align-items: flex-start; gap: 10rpx;
  background: #eff6ff; border-radius: 14rpx; padding: 16rpx 20rpx;
}
.tip-icon { font-size: 26rpx; flex-shrink: 0; }
.tip-text { font-size: 25rpx; color: #1d4ed8; line-height: 1.5; }

/* Message group */
.msg-group { margin-bottom: 20rpx; }
.msg-role-label {
  font-size: 22rpx; color: #94a3b8; margin-left: 88rpx;
  margin-bottom: 6rpx; display: block;
}
.user-label-right { text-align: right; margin-left: 0; margin-right: 88rpx; }

.msg-row { display: flex; align-items: flex-start; gap: 16rpx; }
.ai-row  { flex-direction: row; }
.user-row { flex-direction: row-reverse; }

/* Avatars */
.avatar {
  width: 72rpx; height: 72rpx; border-radius: 36rpx;
  background: #fff; display: flex; align-items: center; justify-content: center;
  font-size: 38rpx; box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.08); flex-shrink: 0;
}
.ai-avatar  { background: #eff6ff; }
.user-avatar { background: #f0fdf4; }

/* Bubble col */
.bubble-col {
  flex: 1; max-width: 72%;
  display: flex; flex-direction: column; gap: 10rpx;
}

/* Bubbles */
.bubble { border-radius: 24rpx; padding: 22rpx 28rpx; word-break: break-word; }
.ai-bubble {
  background: #fff; border-top-left-radius: 6rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.06); max-width: 100%;
  position: relative; overflow: hidden;
}
.user-bubble {
  background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
  border-top-right-radius: 6rpx;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.25);
  align-self: flex-end; max-width: 72%;
}
.bubble-text { font-size: 29rpx; line-height: 1.65; color: #1e293b; }
.user-text   { color: #fff; }

/* Streaming cursor */
.streaming-dot {
  display: inline-block;
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: #3b82f6; margin-left: 6rpx;
  animation: stream-blink 0.8s infinite;
  vertical-align: middle;
}
@keyframes stream-blink {
  0%, 100% { opacity: 1; }
  50%      { opacity: 0.2; }
}

/* ─── Spoiler overlay ───────────────────────────────────────────── */
.spoiler-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.92);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.12s ease;
}
.spoiler-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  pointer-events: none;
}
.spoiler-off {
  opacity: 0;
  pointer-events: none;
}

/* ─── Replay button ─────────────────────────────────────────────── */
.replay-row {
  display: flex;
  padding: 0 4rpx;
}
.btn-replay {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  background: #eff6ff;
  border-radius: 32rpx;
  border: 1rpx solid #bfdbfe;
}
.btn-replay:active {
  background: #dbeafe;
}
.replay-icon { font-size: 26rpx; }
.replay-label { font-size: 24rpx; color: #3b82f6; font-weight: 500; }

/* ─── Typing indicator ───────────────────────────────────────────── */
.typing-bubble { padding: 22rpx 28rpx; min-width: 100rpx; }
.typing-dots { display: flex; align-items: center; gap: 10rpx; height: 28rpx; }
.tdot {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: #94a3b8; animation: tdot-pulse 1.4s ease-in-out infinite;
}
.tdot-2 { animation-delay: 0.2s; }
.tdot-3 { animation-delay: 0.4s; }
@keyframes tdot-pulse {
  0%, 80%, 100% { transform: scale(0.7); opacity: 0.4; }
  40%            { transform: scale(1.0); opacity: 0.9; }
}

/* ─── Coach feedback card ───────────────────────────────────────── */
.coach-card {
  background: #eff6ff; border: 1.5rpx solid #bfdbfe;
  border-radius: 20rpx; padding: 20rpx 24rpx;
}
.coach-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.score-pill-label { font-size: 20rpx; color: #64748b; flex-shrink: 0; }
.score-pill {
  display: flex; align-items: baseline; gap: 2rpx;
  padding: 6rpx 16rpx; border-radius: 20rpx; flex-shrink: 0;
}
.score-pill.pill-great { background: #d1fae5; }
.score-pill.pill-ok    { background: #fef3c7; }
.score-pill.pill-low   { background: #fee2e2; }
.score-pill-num { font-size: 30rpx; font-weight: bold; }
.pill-great .score-pill-num { color: #065f46; }
.pill-ok    .score-pill-num { color: #92400e; }
.pill-low   .score-pill-num { color: #991b1b; }
.score-pill-unit { font-size: 22rpx; }
.pill-great .score-pill-unit { color: #065f46; }
.pill-ok    .score-pill-unit { color: #92400e; }
.pill-low   .score-pill-unit { color: #991b1b; }

.score-bar-wrap {
  flex: 1; height: 8rpx; background: #dbeafe;
  border-radius: 4rpx; overflow: hidden;
}
.score-bar-fill {
  height: 100%; border-radius: 4rpx; transition: width 0.6s ease;
}
.bar-great { background: #10b981; }
.bar-ok    { background: #f59e0b; }
.bar-low   { background: #ef4444; }
.coach-text { font-size: 26rpx; color: #1e40af; line-height: 1.6; }

/* ─── Session end summary ───────────────────────────────────────── */
.summary-wrap { margin-top: 12rpx; }
.summary-card {
  background: #fff; border-radius: 28rpx; overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(15, 23, 42, 0.08);
}
.summary-band {
  padding: 48rpx 40rpx 36rpx; display: flex;
  flex-direction: column; align-items: center; gap: 10rpx;
}
.band-pass { background: linear-gradient(135deg, #059669 0%, #10b981 100%); }
.band-fail { background: linear-gradient(135deg, #d97706 0%, #f59e0b 100%); }
.summary-emoji    { font-size: 80rpx; }
.summary-headline { font-size: 40rpx; font-weight: 700; color: #fff; }
.summary-sub      { font-size: 26rpx; color: rgba(255, 255, 255, 0.8); }

.score-circle-wrap {
  display: flex; flex-direction: column; align-items: center;
  gap: 20rpx; padding: 40rpx 40rpx 28rpx;
}
.score-circle {
  width: 180rpx; height: 180rpx; border-radius: 50%; border: 8rpx solid;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.circle-pass    { border-color: #10b981; }
.circle-fail    { border-color: #f59e0b; }
.circle-pending { border-color: #94a3b8; border-style: dashed; }
.circle-num  { font-size: 64rpx; font-weight: bold; line-height: 1; }
.circle-pass .circle-num    { color: #10b981; }
.circle-fail .circle-num    { color: #f59e0b; }
.circle-pending .circle-num { color: #94a3b8; }
.circle-unit { font-size: 26rpx; color: #64748b; }
.tag-pending { background: #f1f5f9; border-color: #cbd5e1; }
.tag-pending text { color: #64748b; }

.result-tag {
  font-size: 28rpx; font-weight: 600;
  padding: 10rpx 28rpx; border-radius: 24rpx;
}
.tag-pass { background: #d1fae5; color: #065f46; }
.tag-fail { background: #fef3c7; color: #92400e; }

.summary-body { padding: 0 40rpx 28rpx; }
.summary-text { font-size: 27rpx; color: #475569; line-height: 1.7; }

.summary-actions {
  padding: 0 32rpx 40rpx; display: flex; flex-direction: column; gap: 16rpx;
}
.btn-retry {
  background: #fff; border: 2rpx solid #3b82f6; color: #3b82f6;
  border-radius: 14rpx; height: 96rpx; line-height: 96rpx;
  font-size: 30rpx; font-weight: 600;
}
.btn-retry:active {
  background: #eff6ff;
}
.btn-back {
  background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
  color: #fff; border: none; border-radius: 14rpx; height: 96rpx;
  line-height: 96rpx; font-size: 30rpx; font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.25);
}

/* ─── Evaluation section ───────────────────────────────────────── */
.eval-section { padding: 0 32rpx 20rpx; }

.eval-status-card {
  background: #eff6ff; border: 1.5rpx solid #bfdbfe;
  border-radius: 20rpx; padding: 24rpx; text-align: center;
}
.eval-status-card.eval-failed {
  background: #fef2f2; border-color: #fecaca;
}
.eval-status-row {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  margin-bottom: 8rpx;
}
.eval-spinner {
  width: 28rpx; height: 28rpx; border: 4rpx solid #bfdbfe;
  border-top-color: #3b82f6; border-radius: 50%;
  animation: eval-spin 0.8s linear infinite;
}
@keyframes eval-spin {
  to { transform: rotate(360deg); }
}
.eval-status-text { font-size: 26rpx; color: #1e40af; font-weight: 600; }
.eval-failed .eval-status-text { color: #991b1b; }
.eval-status-sub { font-size: 22rpx; color: #94a3b8; }

.eval-result-card {
  background: #f0fdf4; border: 1.5rpx solid #bbf7d0;
  border-radius: 20rpx; padding: 24rpx; overflow: hidden;
}
.eval-result-header { margin-bottom: 20rpx; }
.eval-result-title {
  font-size: 26rpx; font-weight: 700; color: #065f46;
}

.eval-scores-row {
  display: flex; justify-content: center; gap: 32rpx;
  margin-bottom: 24rpx;
}
.eval-score-item {
  display: flex; flex-direction: column; align-items: center; gap: 6rpx;
}
.eval-score-item.eval-final .eval-score-num {
  font-size: 48rpx; color: #10b981;
}
.eval-score-num { font-size: 36rpx; font-weight: bold; color: #1e293b; line-height: 1; }
.eval-score-label { font-size: 22rpx; color: #64748b; }

.eval-breakdown { margin-bottom: 16rpx; }
.breakdown-item {
  display: flex; align-items: center; gap: 12rpx;
  margin-bottom: 12rpx;
}
.breakdown-label { font-size: 24rpx; color: #475569; width: 120rpx; flex-shrink: 0; }
.breakdown-bar-wrap {
  flex: 1; height: 12rpx; background: #d1fae5;
  border-radius: 6rpx; overflow: hidden;
}
.breakdown-bar {
  height: 100%; background: #10b981; border-radius: 6rpx;
  transition: width 0.6s ease;
}
.breakdown-num { font-size: 24rpx; font-weight: 600; color: #065f46; width: 60rpx; text-align: right; }

.eval-feedback { margin-top: 8rpx; }
.eval-feedback-text { font-size: 25rpx; color: #065f46; line-height: 1.6; }

.scroll-anchor { height: 24rpx; }

/* ═══ Input area ════════════════════════════════════════════════════ */
.input-area {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #fff; border-top: 1rpx solid #e2e8f0;
  box-shadow: 0 -4rpx 20rpx rgba(15, 23, 42, 0.04);
  padding: 16rpx 24rpx 16rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 20;
}

/* Shared hint row (voice mode) */
.input-hint-row {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 10rpx;
}
.input-hint { font-size: 23rpx; color: #94a3b8; padding-left: 4rpx; }

/* Mode switch button (voice / text) */
.btn-mode-switch {
  width: 72rpx; height: 72rpx; border-radius: 36rpx;
  background: #f1f5f9; display: flex;
  align-items: center; justify-content: center;
  flex-shrink: 0;
}
.btn-mode-switch:active {
  background: #e2e8f0;
}
.mode-icon { font-size: 32rpx; color: #475569; }

/* ─── Voice mode ─────────────────────────────────────────────── */
.voice-input-wrap { }

.btn-record {
  width: 100%; height: 120rpx; border-radius: 60rpx;
  background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
  border: 3rpx solid #93c5fd;
  display: flex; align-items: center; justify-content: center;
  gap: 16rpx; position: relative; overflow: hidden;
  transition: all 0.2s;
}
.btn-record:active,
.btn-record.btn-recording {
  background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
  border-color: #3b82f6;
  transform: scale(0.97);
}
.btn-record.btn-disabled {
  opacity: 0.5; pointer-events: none;
}

.record-icon-wrap {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex; align-items: center; justify-content: center;
}
.record-icon { font-size: 36rpx; }

.record-label { font-size: 30rpx; font-weight: 600; color: #1d4ed8; }
.btn-recording .record-label { color: #fff; }

/* Recording pulse rings */
.record-pulse {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
}
.pulse-ring {
  position: absolute; top: 50%; left: 50%;
  width: 120rpx; height: 120rpx;
  margin-top: -60rpx; margin-left: -60rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  animation: pulse-grow 1.6s ease-out infinite;
}
.pulse-2 { animation-delay: 0.8s; }
@keyframes pulse-grow {
  0%   { transform: scale(1); opacity: 0.6; }
  100% { transform: scale(2.5); opacity: 0; }
}

/* ─── Text mode ──────────────────────────────────────────────── */
.text-input-wrap { }

.input-row { display: flex; align-items: center; gap: 12rpx; }

.text-input {
  flex: 1; height: 76rpx; background: #f1f5f9;
  border-radius: 38rpx; padding: 0 28rpx;
  font-size: 29rpx; color: #1e293b;
  border: 2rpx solid #e2e8f0; transition: border-color 0.2s;
}
.text-input:focus { border-color: #93c5fd; }

.btn-send {
  width: 76rpx; height: 76rpx; border-radius: 50%;
  background: #e2e8f0; display: flex;
  align-items: center; justify-content: center;
  flex-shrink: 0; transition: background 0.2s;
}
.btn-send.send-active {
  background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.3);
}
.send-arrow {
  font-size: 34rpx; color: #fff; font-weight: bold;
  line-height: 1; margin-top: -4rpx;
}
