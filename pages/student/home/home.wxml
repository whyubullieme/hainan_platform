<!--pages/student/home/home.wxml-->
<view class="home-container">
  <view class="header-bar">
    <text class="refresh-link" bindtap="handleRefresh">⟳ 刷新</text>
    <text class="logout-link" bindtap="handleLogout">退出登录</text>
  </view>
  <view class="greeting-bar">
    <text class="greeting-text">{{greetingText}}</text>
    <text class="class-name" wx:if="{{className}}">在 {{className}}</text>
  </view>

  <!-- 体验模式提示 -->
  <view class="demo-banner" wx:if="{{isDemo}}">
    <text class="demo-text">🎯 体验模式：当前为演示数据</text>
  </view>

  <!-- 日期和天数 -->
  <view class="date-header">
    <view class="day-info">
      <text class="day-label">第</text>
      <text class="day-number">{{dayNumber}}</text>
      <text class="day-label">天</text>
    </view>
    <text class="date-text">{{currentDate}}</text>
    <button
      class="checkin-header-btn checkin-disabled"
      wx:if="{{!status.checkedIn && !isDemo}}"
      size="mini"
      disabled
    >签到（即将开放）</button>
    <text class="checked-badge" wx:elif="{{status.checkedIn && !isDemo}}">✓ 已签到</text>
  </view>

  <!-- 快捷操作 -->
  <view class="quick-actions">
    <view class="action-card primary" bindtap="goToMyTasks">
      <text class="action-icon">📚</text>
      <text class="action-label">题库练习</text>
    </view>
    <view class="action-card" bindtap="goToProgress">
      <text class="action-icon">📊</text>
      <text class="action-label">学习进度</text>
    </view>
    <view class="action-card" bindtap="goToSubmission">
      <text class="action-icon">📝</text>
      <text class="action-label">提交记录</text>
    </view>
    <view class="action-card" bindtap="goToFeedback">
      <text class="action-icon">💬</text>
      <text class="action-label">老师点评</text>
    </view>
  </view>
</view>
