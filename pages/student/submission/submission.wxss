/* pages/student/submission/submission.wxss */
.section {
  padding: 32rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}

.date-picker-row {
  margin-bottom: 32rpx;
  background: #fff;
  border: 1rpx solid #e6edf7;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 8rpx 16rpx rgba(15, 23, 42, 0.04);
}

.date-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.picker-value {
  padding: 24rpx;
  background: #f8fbff;
  border-radius: 12rpx;
  border: 1rpx solid #dbe5f3;
  font-size: 30rpx;
  color: #334155;
}

.filter-tabs {
  margin-top: 16rpx;
}

.tab {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab.active {
  color: #14532d;
}

.records-list {
  margin-top: 16rpx;
}

.record-group {
  margin-bottom: 32rpx;
  background: #fff;
  border: 1rpx solid #e6edf7;
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
}

.group-date {
  font-size: 26rpx;
  color: #4b5563;
  margin-bottom: 12rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid #e8edf5;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.record-item .task-title {
  font-size: 30rpx;
  color: #333;
}

.record-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.record-meta {
  font-size: 22rpx;
  color: #64748b;
}

.record-redo-comment {
  font-size: 22rpx;
  color: #b45309;
}

.record-eval {
  margin-top: 6rpx;
}

.eval-status-text {
  font-size: 24rpx;
  color: #1890ff;
}

.eval-status-text.failed {
  color: #cf1322;
}

.eval-score-text {
  font-size: 24rpx;
  color: #07c160;
  font-weight: 500;
}

.submitted-at {
  font-size: 24rpx;
  color: #07c160;
}

.submitted-at.redo {
  color: #d97706;
}

.empty-state {
  text-align: center;
  padding: 80rpx;
  color: #999;
  font-size: 28rpx;
}
