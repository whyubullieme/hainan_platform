/* pages/student/home/home.wxss */
.home-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
}

.refresh-link {
  font-size: 28rpx;
  color: #07c160;
}

.logout-link {
  font-size: 26rpx;
  color: #999;
}

.greeting-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0 32rpx 20rpx;
  padding: 14rpx 18rpx;
  background: #fff;
  border: 1rpx solid #e6edf7;
  border-radius: 12rpx;
}

.greeting-text {
  font-size: 26rpx;
  color: #334155;
}

.greeting-bar .class-name {
  font-size: 24rpx;
  color: #6b7280;
}

.demo-banner {
  background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
  padding: 24rpx;
  text-align: center;
}

.demo-text {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.date-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 40rpx;
  color: #fff;
}

.day-info {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 20rpx;
}

.day-label {
  font-size: 32rpx;
  margin: 0 8rpx;
}

.day-number {
  font-size: 80rpx;
  font-weight: bold;
  margin: 0 16rpx;
}

.date-text {
  display: block;
  text-align: center;
  font-size: 28rpx;
  opacity: 0.9;
}

.checkin-header-btn {
  margin-top: 24rpx;
  background-color: rgba(255,255,255,0.3);
  color: #fff;
  border: 1rpx solid rgba(255,255,255,0.6);
}

.checkin-header-btn.checkin-disabled {
  opacity: 0.6;
}

.checked-badge {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: rgba(255,255,255,0.95);
}

/* Quick action cards */
.quick-actions {
  margin: 40rpx 30rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.action-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.action-card.primary {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
}

.action-card.primary .action-icon,
.action-card.primary .action-label {
  color: #fff;
}

.action-icon {
  font-size: 48rpx;
}

.action-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #334155;
}
