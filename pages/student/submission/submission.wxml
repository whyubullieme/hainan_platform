<!--pages/student/submission/submission.wxml-->
<view class="container">
  <view class="logout-wrap">
    <text class="logout-link" bindtap="handleLogout">退出登录</text>
  </view>

  <view class="section">
    <view class="section-title">我的提交记录</view>
    <view class="date-picker-row">
      <text class="date-label">选择日期</text>
      <picker 
        mode="date" 
        value="{{selectedDate}}" 
        start="{{startDate}}" 
        end="{{endDate}}"
        bindchange="onDateChange"
      >
        <view class="picker-value">{{filterMode === 'all' ? '全部记录' : selectedDate}}</view>
      </picker>
      <view class="filter-tabs">
        <text 
          class="tab {{filterMode === 'all' ? 'active' : ''}}" 
          bindtap="setFilterMode" 
          data-mode="all"
        >全部</text>
        <text 
          class="tab {{filterMode === 'date' ? 'active' : ''}}" 
          bindtap="setFilterMode" 
          data-mode="date"
        >按日期</text>
      </view>
    </view>

    <view class="records-list" wx:if="{{records.length > 0}}">
      <view class="record-group" wx:for="{{groupedRecords}}" wx:key="dateStr">
        <view class="group-date">{{item.dateStr}} 第{{item.dayNumber}}天</view>
        <view class="record-item" wx:for="{{item.items}}" wx:for-item="rec" wx:key="taskItemId">
          <view class="record-main">
            <text class="task-title">{{rec.taskTitle}}</text>
            <text class="record-meta" wx:if="{{rec.note}}">文字已提交</text>
            <text class="record-meta" wx:if="{{rec.audioFileId}}">音频已提交</text>
            <text class="record-redo-comment" wx:if="{{rec.needsRedo}}">
              老师打回：{{rec.redoComment || '请重做后重新提交'}}
            </text>
            <view class="record-eval" wx:if="{{rec.evaluationStatus}}">
              <text class="eval-status-text {{rec.evaluationStatus}}" wx:if="{{rec.evaluationStatus === 'pending' || rec.evaluationStatus === 'running'}}">评测中</text>
              <text class="eval-status-text failed" wx:elif="{{rec.evaluationStatus === 'failed'}}">评测失败</text>
              <text class="eval-score-text" wx:elif="{{rec.evaluationStatus === 'completed' && rec.finalScore != null}}">总分 {{rec.finalScore}}</text>
            </view>
          </view>
          <text class="submitted-at {{rec.needsRedo ? 'redo' : ''}}">
            {{rec.needsRedo ? '已打回，待重做' : '已提交'}}
          </text>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:else>
      <text>{{filterMode === 'date' && selectedDate ? '该日期暂无提交记录' : '暂无提交记录'}}</text>
    </view>
  </view>
</view>
