<view class="page">
  <view class="topbar">
    <view class="topbar-left">
      <text class="greeting">{{greetingText}}</text>
      <text class="class-tag" wx:if="{{className}}">{{className}}</text>
    </view>
    <text class="logout-link" bindtap="handleLogout">退出</text>
  </view>

  <view class="error" wx:if="{{error}}">{{error}}</view>

  <view class="date-bar">
    <picker mode="date" value="{{date}}" bindchange="handleDateChange">
      <view class="date-picker">
        <text class="date-value">{{date || '选择日期'}}</text>
        <text class="date-day">第 {{dayNumber}} 天</text>
      </view>
    </picker>
    <button class="btn-refresh" size="mini" bindtap="handleRefresh" loading="{{loading}}">刷新</button>
  </view>

  <view class="stats-grid" wx:if="{{overview}}">
    <view class="stat-card">
      <text class="stat-num">{{overview.totalStudents || 0}}</text>
      <text class="stat-label">班级总人数</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{overview.checkedInCount || 0}}</text>
      <text class="stat-label">已签到</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{overview.submittedCount || 0}}</text>
      <text class="stat-label">已提交</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{overview.reviewedCount || 0}}</text>
      <text class="stat-label">已点评</text>
    </view>
  </view>

  <view class="action-cards">
    <view class="action-card card-missing" bindtap="handleViewMissing">
      <text class="action-num">{{missingCount}}</text>
      <text class="action-label">未提交</text>
    </view>
    <view class="action-card card-pending" bindtap="handleViewDone">
      <text class="action-num">{{pendingReviewCount}}</text>
      <text class="action-label">待点评</text>
    </view>
    <view class="action-card card-done" bindtap="handleViewReviewed">
      <text class="action-num">{{overview.reviewedCount || 0}}</text>
      <text class="action-label">已点评</text>
    </view>
  </view>

  <view class="section-card">
    <text class="section-title">任务管理</text>
    <view class="task-date-row">
      <text class="field-label">操作日期</text>
      <picker mode="date" value="{{taskActionDate}}" bindchange="handleTaskActionDateChange">
        <view class="date-chip">{{taskActionDate || '选择日期'}}</view>
      </picker>
    </view>
    <view class="btn-row">
      <button class="btn-primary" bindtap="handleAddDayTasks">添加任务</button>
      <button class="btn-outline-danger" bindtap="handleRevokeDayTasks">撤销任务</button>
    </view>
  </view>

  <view class="section-card">
    <text class="section-title">工具</text>
    <view class="tool-list">
      <view class="tool-item" bindtap="goToTopErrors">
        <text class="tool-name">高频错题分析</text>
        <text class="tool-arrow">></text>
      </view>
      <view class="tool-item" bindtap="handleExportCSV">
        <text class="tool-name">导出班级报表 (CSV)</text>
        <text class="tool-arrow">></text>
      </view>
    </view>
  </view>
</view>
