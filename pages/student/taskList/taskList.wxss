/* pages/student/taskList/taskList.wxss */

.container {
  min-height: 100vh;
  background: #f0f4f8;
  padding: 24rpx 28rpx 48rpx;
}

/* List meta */
.list-meta {
  margin-bottom: 20rpx;
}

.meta-text {
  font-size: 26rpx;
  color: #64748b;
  font-weight: 500;
}

/* Task list */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.task-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
  border: 1rpx solid #e2e8f0;
  transition: transform 0.15s ease;
}

.task-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* Card left */
.card-left {
  flex: 1;
  margin-right: 20rpx;
  min-width: 0;
}

.task-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.task-meta {
  display: block;
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 8rpx;
}

.task-content {
  display: block;
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* Card right */
.card-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
}

/* Status badge */
.status-badge {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.status-badge.done {
  background: rgba(16, 185, 129, 0.1);
  color: #10b981;
}

.status-badge.pending {
  background: #f1f5f9;
  color: #94a3b8;
}

/* Arrow */
.arrow {
  font-size: 40rpx;
  color: #cbd5e1;
  font-weight: 300;
}

/* Empty state */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #94a3b8;
}
