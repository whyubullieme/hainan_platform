/* pages/student/progress/progress.wxss */

.container {
  min-height: 100vh;
  padding: 24rpx 28rpx 48rpx;
  background: #f0f4f8;
}

/* Logout */
.logout-wrap {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 20rpx;
}

.logout-link {
  font-size: 26rpx;
  color: #94a3b8;
}

.logout-link:active {
  color: #64748b;
}

/* Section card */
.section {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
  border: 1rpx solid #e2e8f0;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 6rpx;
}

.section-desc {
  font-size: 26rpx;
  color: #94a3b8;
  margin-bottom: 28rpx;
}

/* Progress meta */
.progress-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.total-days {
  font-size: 28rpx;
  color: #3b82f6;
  font-weight: 600;
}

/* Pagination (component overrides) */
.pagination {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.page-btn {
  font-size: 26rpx;
  color: #3b82f6;
  font-weight: 500;
}

.page-btn.disabled {
  color: #cbd5e1;
}

.page-info {
  font-size: 24rpx;
  color: #64748b;
}

/* Progress list */
.progress-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.day-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  border: 1rpx solid #e2e8f0;
  transition: background 0.2s ease;
}

.day-row.completed {
  background: rgba(16, 185, 129, 0.06);
  border-color: rgba(16, 185, 129, 0.25);
  border-left: 6rpx solid #10b981;
}

/* Day info */
.day-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.day-num {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
}

.day-date {
  font-size: 24rpx;
  color: #94a3b8;
}

/* Day status */
.day-status {
  display: flex;
  gap: 20rpx;
}

.status-item {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 500;
}

.status-item.done {
  color: #10b981;
}

/* Complete badge */
.complete-badge {
  font-size: 22rpx;
  color: #10b981;
  font-weight: 600;
  background: rgba(16, 185, 129, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* Empty state */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #94a3b8;
  font-size: 28rpx;
}
