/* pages/student/taskDetail/taskDetail.wxss */

.container {
  min-height: 100vh;
  padding: 24rpx 28rpx;
  background: #f0f4f8;
}

.logout-wrap {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 20rpx;
}

.logout-link {
  font-size: 24rpx;
  color: #94a3b8;
}

.logout-link:active {
  color: #64748b;
}

.task-detail {
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
  border: 1rpx solid #e2e8f0;
}

.task-type-badge {
  display: inline-block;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  margin-bottom: 24rpx;
  font-weight: 500;
}

.task-type-badge.read-along {
  background: #dbeafe;
  color: #1d4ed8;
}

.task-type-badge.read-aloud {
  background: #d1fae5;
  color: #065f46;
}

.task-type-badge.listening-mcq {
  background: #fef3c7;
  color: #92400e;
}

.task-header {
  margin-bottom: 24rpx;
}

.task-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
  display: block;
  line-height: 1.4;
}

.task-day {
  font-size: 26rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

.task-content {
  padding: 24rpx 0;
  border-top: 1rpx solid #f1f5f9;
}

.content-text {
  font-size: 30rpx;
  color: #1e293b;
  line-height: 1.7;
}

.task-tip {
  padding: 24rpx 0;
  border-top: 1rpx solid #f1f5f9;
}

.task-tip text {
  font-size: 26rpx;
  color: #94a3b8;
  line-height: 1.5;
}

.task-actions {
  margin-top: 40rpx;
}

.submit-box {
  border-top: 1rpx solid #f1f5f9;
  padding-top: 24rpx;
}

.redo-alert {
  margin-bottom: 20rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #fcd34d;
  border-radius: 14rpx;
  background: #fefce8;
}

.redo-alert-title {
  display: block;
  font-size: 26rpx;
  color: #a16207;
  font-weight: 600;
}

.redo-alert-text {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #92400e;
  line-height: 1.5;
}

.submit-label {
  display: block;
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.devtools-tip {
  display: block;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: #f59e0b;
}

.submit-note {
  width: 100%;
  min-height: 200rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  margin-bottom: 18rpx;
  background: #fff;
  font-size: 28rpx;
  color: #1e293b;
}

.answer-label {
  margin-top: 20rpx;
}

.option-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 18rpx 16rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #fff;
  transition: all 0.2s ease;
}

.option-item:active {
  background: #f8fafc;
}

.option-text {
  flex: 1;
  font-size: 27rpx;
  color: #1e293b;
  line-height: 1.5;
}

.btn-prompt-audio {
  background: #fef3c7;
  color: #92400e;
  border: 1rpx solid #fcd34d;
  border-radius: 14rpx;
  font-weight: 500;
}

.btn-prompt-audio:active {
  background: #fde68a;
}

.prompt-text-tip {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.prompt-text-box {
  margin-top: 10rpx;
  margin-bottom: 8rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  border: 1rpx solid #e2e8f0;
  background: #f8fafc;
}

.prompt-text {
  font-size: 28rpx;
  color: #1e293b;
  line-height: 1.5;
}

.session-progress {
  display: block;
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.session-tip {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 14rpx;
}

.session-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
}

.btn-nav {
  background: #f8fafc;
  color: #1e293b;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  font-weight: 500;
}

.btn-nav:active {
  background: #f1f5f9;
}

.session-answered {
  display: block;
  margin-top: 14rpx;
  margin-bottom: 18rpx;
  font-size: 24rpx;
  color: #64748b;
}

.session-result {
  border-top: 1rpx solid #f1f5f9;
  padding-top: 20rpx;
}

.result-title {
  display: block;
  font-size: 32rpx;
  color: #1e293b;
  font-weight: 700;
}

.result-score {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #10b981;
  font-weight: 600;
}

.result-list {
  margin-top: 18rpx;
}

.result-item {
  padding: 16rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #f8fafc;
}

.result-item-title {
  display: block;
  font-size: 26rpx;
  color: #1e293b;
  font-weight: 600;
}

.result-item-line {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #475569;
}

.result-item-line.correct {
  color: #10b981;
  font-weight: 500;
}

.audio-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
  flex-wrap: wrap;
}

.btn-audio {
  background: #eff6ff;
  color: #3b82f6;
  border: 1rpx solid #bfdbfe;
  border-radius: 14rpx;
  font-weight: 500;
}

.btn-audio:active {
  background: #dbeafe;
}

.btn-audio-preview {
  background: #f0fdf4;
  color: #10b981;
  border: 1rpx solid #bbf7d0;
  border-radius: 14rpx;
  font-weight: 500;
}

.btn-audio-preview:active {
  background: #dcfce7;
}

.btn-audio-file {
  background: #fef3c7;
  color: #92400e;
  border: 1rpx solid #fcd34d;
  border-radius: 14rpx;
  font-weight: 500;
}

.btn-audio-file:active {
  background: #fde68a;
}

.btn-clear-audio {
  background: #fef2f2;
  color: #ef4444;
  border: 1rpx solid #fecaca;
  border-radius: 14rpx;
  font-weight: 500;
}

.btn-clear-audio:active {
  background: #fee2e2;
}

.audio-name {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin: 10rpx 0 18rpx;
}

.btn-submit {
  width: 100%;
  background: linear-gradient(135deg, #10b981, #059669);
  color: #fff;
  border: none;
  border-radius: 14rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.25);
  letter-spacing: 1rpx;
}

.btn-submit[disabled] {
  opacity: 0.6;
}

.task-submitted {
  margin-top: 32rpx;
}

.submitted-badge {
  font-size: 28rpx;
  color: #10b981;
  font-weight: 600;
}

.evaluation-section {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f1f5f9;
}

.eval-status {
  font-size: 26rpx;
  color: #3b82f6;
  font-weight: 500;
}

.eval-status.eval-failed {
  color: #ef4444;
}

.eval-result {
  margin-top: 12rpx;
}

.eval-row {
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.eval-row.eval-total {
  font-weight: 600;
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #e2e8f0;
}

.eval-label {
  color: #64748b;
  margin-right: 8rpx;
}

.eval-value {
  color: #1e293b;
}

.eval-value.pass {
  color: #10b981;
  font-weight: 600;
}

.eval-value.fail {
  color: #ef4444;
  font-weight: 600;
}

.eval-score {
  font-size: 24rpx;
  color: #64748b;
}

.eval-tip {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #e2e8f0;
}

.eval-word-error {
  display: inline-block;
  margin-right: 12rpx;
  font-size: 24rpx;
  color: #ef4444;
  background: #fef2f2;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-bottom: 6rpx;
}

.loading-state,
.empty-state {
  text-align: center;
  padding: 80rpx;
  color: #94a3b8;
  font-size: 28rpx;
}
