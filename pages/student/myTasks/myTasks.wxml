<!--pages/student/myTasks/myTasks.wxml-->
<view class="container">
  <view class="logout-wrap">
    <text class="logout-link" bindtap="handleLogout">退出登录</text>
  </view>

  <view class="section">
    <view class="section-title">训练计划</view>
    <view class="plan-intro">题库任务可自由练习，第X天仅作进度标识</view>
    <view class="plan-meta" wx:if="{{totalDays > 0}}">
      <text class="total-days">共 {{totalDays}} 天</text>
      <view class="pagination" wx:if="{{totalPages > 1}}">
        <text class="page-btn {{currentPage <= 1 ? 'disabled' : ''}}" bindtap="prevPage">上一页</text>
        <text class="page-info">第 {{currentPage}} / {{totalPages}} 页</text>
        <text class="page-btn {{currentPage >= totalPages ? 'disabled' : ''}}" bindtap="nextPage">下一页</text>
      </view>
    </view>

    <view class="day-block" wx:for="{{displayedDays}}" wx:key="dayNumber">
      <view class="day-header {{item.status}}">
        <text class="day-title">第{{item.dayNumber}}天 {{item.dateStr}}</text>
        <text class="day-badge" wx:if="{{item.status === 'today'}}">今日</text>
      </view>

      <view class="task-list">
        <block wx:if="{{item.tasks && item.tasks.length > 0}}">
          <view 
            class="task-item" 
            wx:for="{{item.tasks}}" 
            wx:for-item="t" 
            wx:key="taskItemId"
            data-task-id="{{t.taskItemId}}"
            data-day="{{item.dayNumber}}"
            bindtap="viewTaskDetail"
          >
            <view class="task-content">
              <text class="task-title">{{t.title}}</text>
              <text class="task-status" wx:if="{{t.submitted}}">✓ 已提交</text>
              <text class="task-status pending" wx:else>待提交</text>
            </view>
            <view 
              class="task-actions" 
              catchtap="handleSubmit" 
              wx:if="{{!t.submitted}}"
              data-task-id="{{t.taskItemId}}"
              data-day="{{item.dayNumber}}"
            >
              <button class="action-btn" size="mini">我已提交</button>
            </view>
          </view>
        </block>
        <view class="task-placeholder" wx:else>
          <text>待教师添加任务</text>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{displayedDays.length === 0 && !loading}}">
      <text>暂无任务</text>
    </view>
  </view>
</view>
