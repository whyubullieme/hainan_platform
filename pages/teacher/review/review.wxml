<view class="container">
  <view class="logout-wrap">
    <text class="logout-link" bindtap="handleLogout">退出登录</text>
  </view>

  <view class="info">
    <text class="student">学生：{{studentName || studentId}}</text>
    <text class="day">第 {{dayNumber}} 天</text>
  </view>

  <view class="submission-panel">
    <view class="submission-title">学生提交内容</view>
    <view class="task-progress">
      任务完成：{{submittedTaskCount}} / {{dayTaskCount}}
      <text class="task-progress-warn" wx:if="{{!hasManualTasks}}">（当日无朗读/跟读任务）</text>
      <text class="task-progress-ok" wx:if="{{allTaskDone && hasManualTasks}}">（可提交点评）</text>
      <text class="task-progress-warn" wx:elif="{{hasManualTasks}}">（未全部完成，暂不可提交点评）</text>
    </view>
    <view class="submission-loading" wx:if="{{loadingSubmissions}}">加载中...</view>
    <view class="submission-empty" wx:elif="{{submissions.length === 0}}">
      暂无提交内容（请确认学生已提交文字或音频）
    </view>
    <view class="submission-list" wx:else>
      <view class="submission-item" wx:for="{{submissions}}" wx:key="_id">
        <text class="sub-task">{{item.taskTitle}}</text>
        <text class="sub-redo" wx:if="{{item.needsRedo}}">
          已打回：{{item.redoComment || '待学生重做'}}
        </text>
        <text class="sub-note" wx:if="{{item.note}}">文字：{{item.note}}</text>
        <view class="sub-ai-eval" wx:if="{{item.evaluationStatus === 'completed'}}">
          <view class="ai-eval-row">
            <text class="ai-eval-label">语义：</text>
            <text class="ai-eval-value {{item.semanticPassed ? 'pass' : 'fail'}}">{{item.semanticPassed ? '✓ 通过' : '✗ 未通过'}}</text>
          </view>
          <view class="ai-eval-row" wx:if="{{item.pronScore != null}}">
            <text class="ai-eval-label">发音分：</text>
            <text class="ai-eval-value">{{item.pronScore}}</text>
          </view>
          <view class="ai-eval-row" wx:if="{{item.asrText}}">
            <text class="ai-eval-label">识别：</text>
            <text class="ai-eval-asr">{{item.asrText}}</text>
          </view>
          <view class="ai-eval-tip" wx:if="{{item.pronDetails && item.pronDetails.words && item.pronDetails.words.length > 0}}">
            <text class="ai-eval-label">错词：</text>
            <block wx:for="{{item.pronDetails.words}}" wx:for-item="w" wx:key="word">
              <text wx:if="{{w.errorType}}" class="ai-eval-word">{{w.word}}({{w.errorType}})</text>
            </block>
          </view>
        </view>
        <view class="sub-ai-pending" wx:elif="{{item.evaluationStatus === 'pending' || item.evaluationStatus === 'running'}}">
          <text class="ai-eval-status">AI 评测中</text>
        </view>
        <view class="sub-audio" wx:if="{{item.audioTempUrl}}">
          <text class="sub-audio-name">{{item.audioFileName || '朗读音频'}}</text>
          <view class="sub-audio-actions">
            <button
              size="mini"
              class="btn-audio-play"
              data-url="{{item.audioTempUrl}}"
              data-sid="{{item._id}}"
              bindtap="playSubmissionAudio"
            >
              {{playingSubmissionId === item._id ? '重新播放' : '播放音频'}}
            </button>
            <button
              wx:if="{{playingSubmissionId === item._id}}"
              size="mini"
              class="btn-audio-stop"
              bindtap="stopSubmissionAudio"
            >
              停止
            </button>
          </view>
          <audio
            controls
            src="{{item.audioTempUrl}}"
          ></audio>
        </view>
      </view>
    </view>
  </view>

  <!-- Dialogue sessions section -->
  <view class="dialogue-panel" wx:if="{{dialogueSessions.length > 0 || loadingDialogue}}">
    <view class="submission-title">对话练习记录</view>
    <view class="submission-loading" wx:if="{{loadingDialogue}}">加载中...</view>
    <view class="dialogue-list" wx:else>
      <view class="dialogue-card" wx:for="{{dialogueSessions}}" wx:key="_id">
        <view class="dialogue-header" bindtap="toggleSessionExpand" data-id="{{item._id}}">
          <view class="dialogue-info">
            <text class="dialogue-scene">{{item.sceneName}}</text>
            <text class="dialogue-meta">Lv.{{item.level}} · {{item.turnCount}}轮</text>
          </view>
          <view class="dialogue-score-wrap">
            <text class="dialogue-score {{item.finalScore != null ? (item.passed ? 'score-pass' : 'score-fail') : 'score-pending'}}">
              {{item.finalScore != null ? item.finalScore + '分' : item.evaluationStatus === 'completed' ? (item.totalScore != null ? item.totalScore + '分' : '--') : '评分中'}}
            </text>
            <text class="expand-arrow">{{expandedSessionId === item._id ? '▲' : '▼'}}</text>
          </view>
        </view>
        <!-- Expanded: show turns + breakdown -->
        <view class="dialogue-detail" wx:if="{{expandedSessionId === item._id}}">
          <view class="dialogue-breakdown" wx:if="{{item.semanticBreakdown}}">
            <text class="bd-item" wx:if="{{item.semanticBreakdown.greeting != null}}">礼仪:{{item.semanticBreakdown.greeting}}</text>
            <text class="bd-item" wx:if="{{item.semanticBreakdown.information != null}}">信息:{{item.semanticBreakdown.information}}</text>
            <text class="bd-item" wx:if="{{item.semanticBreakdown.service != null}}">服务:{{item.semanticBreakdown.service}}</text>
            <text class="bd-item" wx:if="{{item.semanticBreakdown.closing != null}}">结束:{{item.semanticBreakdown.closing}}</text>
            <text class="bd-item" wx:if="{{item.semanticBreakdown.fluency != null}}">流利:{{item.semanticBreakdown.fluency}}</text>
          </view>
          <view class="dialogue-feedback" wx:if="{{item.semanticFeedback}}">
            <text>{{item.semanticFeedback}}</text>
          </view>
          <view class="dialogue-turns">
            <view class="turn-item" wx:for="{{item.turns}}" wx:for-item="turn" wx:key="round">
              <view class="turn-user">
                <text class="turn-label">学生 (R{{turn.round}}) {{turn.inputMode === 'voice' ? '🎤' : '⌨️'}}:</text>
                <text class="turn-text">{{turn.userText || '(无)'}}</text>
              </view>
              <view class="turn-ai">
                <text class="turn-label">AI:</text>
                <text class="turn-text">{{turn.aiReply || '(无)'}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <textarea
    class="comment"
    placeholder="输入点评内容（最多 500 字）"
    maxlength="500"
    value="{{comment}}"
    bindinput="handleCommentInput"
  />

  <view class="error" wx:if="{{error}}">{{error}}</view>

  <view class="action-row">
    <button class="btn-return" bindtap="handleReturnForRedo" loading="{{returning}}" disabled="{{saving || returning || submittedTaskCount === 0 || !hasManualTasks}}">
      打回重做
    </button>
    <button class="btn-save" bindtap="handleSave" loading="{{saving}}" disabled="{{saving || returning || !allTaskDone || !hasManualTasks}}">
      {{hasManualTasks ? (allTaskDone ? '保存点评' : '待学生完成全部任务后可点评') : '当日无人工点评任务'}}
    </button>
  </view>
</view>
