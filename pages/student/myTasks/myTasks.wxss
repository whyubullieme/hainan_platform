/* pages/student/myTasks/myTasks.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 40rpx 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #334155;
  margin-bottom: 32rpx;
}

.type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.type-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 48rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.type-card:active {
  opacity: 0.85;
}

.type-icon {
  font-size: 64rpx;
}

.type-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a2233;
}

.type-desc {
  font-size: 24rpx;
  color: #8a93a2;
  text-align: center;
}
