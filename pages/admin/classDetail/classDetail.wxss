/* pages/admin/classDetail/classDetail.wxss */
.logout-wrap {
  padding: 24rpx 32rpx;
  text-align: right;
}

.logout-link {
  font-size: 26rpx;
  color: #666;
}

.container {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.section {
  padding: 32rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}

.info-row {
  margin-bottom: 24rpx;
}

.info-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.info-value, .picker-value {
  font-size: 30rpx;
  color: #333;
}

.input {
  padding: 20rpx;
  background: #fff;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 30rpx;
  color: #333;
}

.code-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.code-text {
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.copy-btn {
  flex-shrink: 0;
}

.btn-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 32rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  color: #fff;
}

.btn-secondary {
  background: #fff;
  color: #07c160;
  border: 2rpx solid #07c160;
}

.btn-danger {
  background: #ff4d4f;
  color: #fff;
}

.add-member-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
}

.btn-sm {
  padding: 20rpx 32rpx;
  font-size: 28rpx;
  background: #07c160;
  color: #fff;
  border-radius: 8rpx;
}

.user-picker {
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.picker-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.user-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
}

.user-item:last-child {
  border-bottom: none;
}

.member-list {
  margin-top: 16rpx;
}

.member-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.member-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.member-name {
  font-size: 30rpx;
  font-weight: 500;
}

.member-role {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.member-role.student {
  background: #e6f7ff;
  color: #1890ff;
}

.member-role.teacher {
  background: #f6ffed;
  color: #52c41a;
}

.member-actions {
  display: flex;
  gap: 12rpx;
}

.btn-role {
  font-size: 24rpx;
}

.btn-remove {
  font-size: 24rpx;
  color: #ff4d4f;
}

.empty-tip {
  text-align: center;
  color: #999;
  padding: 48rpx;
  font-size: 28rpx;
}
